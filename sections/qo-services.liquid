<div class="qo-sv">
  <div class="qo-sv__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="qo-sv__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="qo-sv__grid">

      {%- for i in (1..3) -%}
        {%- assign video_key   = 's' | append: i | append: '_video' -%}
        {%- assign image_key   = 's' | append: i | append: '_image' -%}
        {%- assign title_key   = 's' | append: i | append: '_title' -%}
        {%- assign caption_key = 's' | append: i | append: '_caption' -%}
        {%- assign link_key    = 's' | append: i | append: '_link' -%}

        <a
          class="qo-sv__card{% if i == 2 %} qo-sv__card--featured{% endif %}"
          {% if section.settings[link_key] != blank %}href="{{ section.settings[link_key] }}"{% endif %}
        >
          <!-- Média -->
          <div class="qo-sv__media">
            {%- if section.settings[video_key] != blank -%}
              <video
                src="{{ section.settings[video_key] }}"
                autoplay muted loop playsinline
                class="qo-sv__media-el"
              ></video>
            {%- elsif section.settings[image_key] != blank -%}
              <img
                src="{{ section.settings[image_key] | image_url: width: 600 }}"
                alt="{{ section.settings[title_key] }}"
                class="qo-sv__media-el"
                loading="lazy"
              >
            {%- else -%}
              <div class="qo-sv__media-placeholder">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="8" width="40" height="32" rx="4"/><path d="M20 17l12 7-12 7V17z"/></svg>
              </div>
            {%- endif -%}

            <!-- Overlay dégradé -->
            <div class="qo-sv__overlay"></div>
          </div>

          <!-- Caption bas -->
          <div class="qo-sv__caption">
            <p class="qo-sv__caption-title">{{ section.settings[title_key] }}</p>
            {%- if section.settings[caption_key] != blank -%}
              <p class="qo-sv__caption-text">{{ section.settings[caption_key] }}</p>
            {%- endif -%}
          </div>

        </a>
      {%- endfor -%}

    </div>
  </div>
</div>

{% stylesheet %}
  .qo-sv {
    background: #fff;
    padding: 80px 24px;

    @media (max-width: 900px) { padding: 60px 20px; }
    @media (max-width: 560px) { padding: 48px 16px; }
  }

  .qo-sv__inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .qo-sv__heading {
    text-align: center;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 48px;
    letter-spacing: -0.01em;
  }

  /* ---- Grille ---- */
  .qo-sv__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 16px;
    align-items: end;

    @media (max-width: 749px) {
      grid-template-columns: repeat(3, 78vw);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 12px;
      gap: 12px;
      margin: 0 -16px;
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  /* ---- Carte ---- */
  .qo-sv__card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    aspect-ratio: 3 / 4;
    background: #111;
    cursor: pointer;

    @media (max-width: 749px) {
      scroll-snap-align: center;
      aspect-ratio: 3 / 4;
      min-width: 0;
    }
  }

  /* Carte centrale légèrement plus grande via grid */
  .qo-sv__card--featured {
    border: 2px solid #C9A96E;
  }

  /* ---- Média ---- */
  .qo-sv__media {
    position: absolute;
    inset: 0;
  }

  .qo-sv__media-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .qo-sv__card:hover .qo-sv__media-el {
    transform: scale(1.04);
  }

  .qo-sv__media-placeholder {
    width: 100%;
    height: 100%;
    background: #222;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
  }

  .qo-sv__media-placeholder svg {
    width: 52px;
    height: 52px;
  }

  /* Dégradé bas */
  .qo-sv__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(0,0,0,0.85) 100%
    );
  }

  /* ---- Caption ---- */
  .qo-sv__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 18px;
    z-index: 2;
  }

  .qo-sv__caption-title {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 6px;
  }

  .qo-sv__caption-text {
    color: rgba(255,255,255,0.78);
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
  }

  .qo-sv__card--featured .qo-sv__caption-title {
    color: #C9A96E;
  }
{% endstylesheet %}

