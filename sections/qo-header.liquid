<!-- ===== HEADER DESKTOP ===== -->
<header class="qo-header" id="qo-header">
  <div class="qo-header__inner">

    <!-- Burger : gauche mobile uniquement -->
    <button class="qo-header__burger" id="qo-burger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <!-- Nav gauche : desktop uniquement -->
    <nav class="qo-header__nav qo-header__nav--left">
      <a href="/pages/services" class="qo-header__link">
        {%- if request.locale.iso_code == 'fr' -%}Services{%- else -%}Services{%- endif -%}
      </a>
      <div class="qo-header__dropdown">
        <button class="qo-header__link qo-header__dropdown-toggle">
          {%- if request.locale.iso_code == 'fr' -%}Soumission{%- else -%}Get a Quote{%- endif -%}
          <svg class="qo-header__caret" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 1l5 5 5-5"/></svg>
        </button>
        <ul class="qo-header__dropdown-menu">
          <li><a href="/pages/quick-order-rapide">{%- if request.locale.iso_code == 'fr' -%}Commande Rapide{%- else -%}Quick Order{%- endif -%}</a></li>
          <li><a href="/pages/quick-order-personnalise">{%- if request.locale.iso_code == 'fr' -%}Commande Personnalisée{%- else -%}Custom Order{%- endif -%}</a></li>
        </ul>
      </div>
    </nav>

    <!-- Logo : toujours centré -->
    <a href="/" class="qo-header__logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" loading="eager">
      {%- else -%}
        <span class="qo-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <!-- Nav droite : desktop uniquement -->
    <nav class="qo-header__nav qo-header__nav--right">
      <a href="/collections/all" class="qo-header__link">
        {%- if request.locale.iso_code == 'fr' -%}Boutique{%- else -%}Shop{%- endif -%}
      </a>
      <div class="qo-header__dropdown">
        <button class="qo-header__link qo-header__dropdown-toggle">
          Support
          <svg class="qo-header__caret" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 1l5 5 5-5"/></svg>
        </button>
        <ul class="qo-header__dropdown-menu">
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/pages/faq">Q&amp;A</a></li>
        </ul>
      </div>

      <!-- Switcher FR / EN -->
      {%- if localization.available_languages.size > 1 -%}
        <div class="qo-lang">
          {%- form 'localization', id: 'qo-lang-form-desktop' -%}
            {%- for lang in localization.available_languages -%}
              <button
                type="submit"
                name="locale_code"
                value="{{ lang.iso_code }}"
                class="qo-lang__btn{%- if lang.iso_code == localization.language.iso_code %} is-active{%- endif -%}"
              >{{ lang.iso_code | upcase }}</button>
              {%- unless forloop.last -%}<span class="qo-lang__sep">|</span>{%- endunless -%}
            {%- endfor -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <a href="/cart" class="qo-header__cart" aria-label="{%- if request.locale.iso_code == 'fr' -%}Panier{%- else -%}Cart{%- endif -%}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        {%- if cart.item_count > 0 -%}<span class="qo-header__cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </nav>

    <!-- Panier : droite mobile uniquement -->
    <a href="/cart" class="qo-header__cart qo-header__cart--mobile" aria-label="Panier">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      {%- if cart.item_count > 0 -%}<span class="qo-header__cart-count">{{ cart.item_count }}</span>{%- endif -%}
    </a>

  </div>
</header>

<div class="qo-header__spacer"></div>

<!-- ===== MENU MOBILE — glisse sous le header ===== -->
<div class="qo-overlay" id="qo-overlay" aria-hidden="true">
  <nav class="qo-overlay__nav">
    <a href="/pages/services" class="qo-overlay__link">Services</a>
    <a href="/pages/quick-order-rapide" class="qo-overlay__link">
      {%- if request.locale.iso_code == 'fr' -%}Commande Rapide{%- else -%}Quick Order{%- endif -%}
    </a>
    <a href="/pages/quick-order-personnalise" class="qo-overlay__link">
      {%- if request.locale.iso_code == 'fr' -%}Commande Personnalisée{%- else -%}Custom Order{%- endif -%}
    </a>
    <a href="/collections/all" class="qo-overlay__link">
      {%- if request.locale.iso_code == 'fr' -%}Boutique{%- else -%}Shop{%- endif -%}
    </a>
    <a href="/pages/contact" class="qo-overlay__link">Contact</a>
    <a href="/pages/faq" class="qo-overlay__link">Q&amp;A</a>

    {%- if localization.available_languages.size > 1 -%}
      <div class="qo-lang qo-lang--mobile">
        {%- form 'localization', id: 'qo-lang-form-mobile' -%}
          {%- for lang in localization.available_languages -%}
            <button
              type="submit"
              name="locale_code"
              value="{{ lang.iso_code }}"
              class="qo-lang__btn{%- if lang.iso_code == localization.language.iso_code %} is-active{%- endif -%}"
            >{{ lang.iso_code | upcase }}</button>
            {%- unless forloop.last -%}<span class="qo-lang__sep">|</span>{%- endunless -%}
          {%- endfor -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </nav>
</div>

<script>
  (function () {
    var header  = document.getElementById('qo-header');
    var burger  = document.getElementById('qo-burger');
    var overlay = document.getElementById('qo-overlay');

    // Scroll : blanc opaque en haut, 75% en bas
    function onScroll() {
      header.classList.toggle('is-scrolled', window.scrollY > 10);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Toggle burger ↔ X + menu
    function closeOverlay() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      burger.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
    }

    burger.addEventListener('click', function () {
      var open = !overlay.classList.contains('is-open');
      if (open) {
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        burger.classList.add('is-open');
        burger.setAttribute('aria-expanded', 'true');
      } else {
        closeOverlay();
      }
    });

    // Fermer si clic sur un lien
    overlay.querySelectorAll('.qo-overlay__link').forEach(function (a) {
      a.addEventListener('click', closeOverlay);
    });
  })();
</script>

{% style %}
  {{ section.settings.nav_font | font_face: font_display: 'swap' }}

  .qo-header__link,
  .qo-header__dropdown-menu li a,
  .qo-overlay__link,
  .qo-header__logo-text {
    font-family: {{ section.settings.nav_font.family }}, sans-serif;
    font-weight: {{ section.settings.nav_font.weight }};
    font-style: {{ section.settings.nav_font.style }};
  }
{% endstyle %}

{% stylesheet %}
  :root {
    --qo-h: 68px;
    --qo-orange: #FF6500;
  }

  /* ===== HEADER ===== */
  .qo-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    height: var(--qo-h);
    background: #fff;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    transition: background 0.3s, backdrop-filter 0.3s;
  }

  .qo-header.is-scrolled {
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .qo-header__spacer { height: var(--qo-h); }

  .qo-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ===== NAV DESKTOP ===== */
  .qo-header__nav {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-evenly;
  }

  .qo-header__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 12px;
    color: #333;

    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }

  .qo-header__link:hover { color: var(--qo-orange); background: rgba(255,101,0,0.06); }

  .qo-header__caret {
    width: 10px; height: 7px;
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  /* ===== DROPDOWN (hover) ===== */
  .qo-header__dropdown { position: relative; }

  .qo-header__dropdown:hover .qo-header__caret { transform: rotate(180deg); }

  .qo-header__dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 6px;
    min-width: 210px;
    padding: 6px;
    list-style: none;
    margin: 0;
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }

  .qo-header__dropdown:hover .qo-header__dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .qo-header__dropdown-menu li a {
    display: block;
    padding: 10px 12px;
    color: #333;

    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.15s, color 0.15s;
  }

  .qo-header__dropdown-menu li a:hover {
    background: rgba(255,101,0,0.08);
    color: var(--qo-orange);
  }

  /* ===== LOGO ===== */
  .qo-header__logo {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .qo-header__logo img { max-height: 40px; width: auto; display: block; }

  .qo-header__logo-text {
    font-size: 1.3rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #111;
  }

  /* ===== CART ===== */
  .qo-header__cart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #333;
    text-decoration: none;
    border-radius: 4px;
    flex-shrink: 0;
    transition: color 0.15s;
  }

  .qo-header__cart:hover { color: var(--qo-orange); }
  .qo-header__cart svg { width: 20px; height: 20px; }

  .qo-header__cart-count {
    position: absolute;
    top: 4px; right: 4px;
    background: var(--qo-orange);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    width: 16px; height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ===== BURGER ===== */
  .qo-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .qo-header__burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: #333;
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1),
                opacity 0.3s ease,
                width 0.3s ease;
  }

  /* Animation → X */
  .qo-header__burger.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .qo-header__burger.is-open span:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .qo-header__burger.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile cart (droite) : caché desktop */
  .qo-header__cart--mobile { display: none; }

  /* ===== MENU MOBILE — glisse depuis sous le header ===== */
  .qo-overlay {
    position: fixed;
    top: var(--qo-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background: #fff;
    display: flex;
    flex-direction: column;
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
  }

  .qo-overlay.is-open {
    transform: translateY(0);
    pointer-events: auto;
  }

  .qo-overlay__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
  }

  .qo-overlay__link {
    display: block;
    width: 100%;
    text-align: center;
    padding: 20px 24px;
    color: #111;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    text-decoration: none;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: color 0.15s;
  }

  .qo-overlay__link:first-child { border-top: 1px solid rgba(0,0,0,0.05); }
  .qo-overlay__link:hover { color: var(--qo-orange); }

  /* ===== LANG SWITCHER ===== */
  .qo-lang {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 4px;
  }

  .qo-lang__btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #888;
    padding: 4px 6px;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
    line-height: 1;
  }

  .qo-lang__btn:hover { color: #111; }

  .qo-lang__btn.is-active {
    color: #FF6500;
    background: rgba(255,101,0,0.08);
  }

  .qo-lang__sep {
    color: #ddd;
    font-size: 0.7rem;
    pointer-events: none;
  }

  .qo-lang--mobile {
    margin: 24px auto 0;
    justify-content: center;
  }

  .qo-lang--mobile .qo-lang__btn {
    font-size: 0.9rem;
    padding: 8px 12px;
    color: #555;
  }

  .qo-lang--mobile .qo-lang__btn.is-active {
    color: #FF6500;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .qo-header__nav { display: none; }
    .qo-header__burger { display: flex; }
    .qo-header__cart--mobile { display: flex; }

    .qo-header__inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      padding: 0 16px;
    }

    .qo-header__logo {
      flex: 1;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QO — Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largeur du logo (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 140
    },
    {
      "type": "font_picker",
      "id": "nav_font",
      "label": "Police du menu",
      "default": "helvetica_n4"
    }
  ],
  "presets": [{ "name": "QO — Header" }]
}
{% endschema %}
