<div class="qo-brands">
  {%- if section.settings.label != blank -%}
    <p class="qo-brands__label">{{ section.settings.label }}</p>
  {%- endif -%}

  <div class="qo-brands__track-wrap">
    <div class="qo-brands__track">

      {%- comment -%} First pass {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          <div class="qo-brands__item" {{ block.shopify_attributes }}>
            <img
              src="{{ block.settings.logo | image_url: width: 300 }}"
              alt="{{ block.settings.name }}"
              loading="lazy"
            >
          </div>
        {%- elsif block.settings.name != blank -%}
          <div class="qo-brands__item qo-brands__item--text" {{ block.shopify_attributes }}>
            {{ block.settings.name }}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          <div class="qo-brands__item" aria-hidden="true">
            <img
              src="{{ block.settings.logo | image_url: width: 300 }}"
              alt=""
              loading="lazy"
            >
          </div>
        {%- elsif block.settings.name != blank -%}
          <div class="qo-brands__item qo-brands__item--text" aria-hidden="true">
            {{ block.settings.name }}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>
  </div>
</div>

{% stylesheet %}
  .qo-brands {
    background: #fff;
    padding: 48px 0;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
    overflow: hidden;
  }

  .qo-brands__label {
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #aaa;
    margin: 0 0 28px;
  }

  .qo-brands__track-wrap {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }

  .qo-brands__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: qo-scroll 36s linear infinite;
  }

  .qo-brands__track:hover { animation-play-state: paused; }

  @keyframes qo-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .qo-brands__item {
    flex-shrink: 0;
    padding: 0 48px;
    display: flex;
    align-items: center;
  }

  .qo-brands__item img {
    height: 44px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    display: block;
    filter: grayscale(100%);
    opacity: 0.45;
    transition: opacity 0.25s ease, filter 0.25s ease;
  }

  .qo-brands__item img:hover {
    filter: none;
    opacity: 1;
  }

  .qo-brands__item--text {
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ccc;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .qo-brands__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "QO — Marques fournisseurs",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Titre",
      "default": "Nos marques"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom (si pas de logo)"
        }
      ]
    }
  ],
  "presets": [{ "name": "QO — Marques fournisseurs" }]
}
{% endschema %}
