
<div class="quick-order-choice color-{{ section.settings.color_scheme }}">
  <div class="quick-order-choice__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="quick-order-choice__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="quick-order-choice__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="quick-order-choice__cards">

      <!-- Carte 1 : Commande Rapide -->
      <a href="{{ section.settings.card1_link }}" class="quick-order-choice__card quick-order-choice__card--1">
        <div class="quick-order-choice__card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8h4l5 22h18l4-14H13"/>
            <circle cx="20" cy="36" r="2"/>
            <circle cx="33" cy="36" r="2"/>
            <path d="M30 16l-6 6-3-3"/>
          </svg>
        </div>
        <h3 class="quick-order-choice__card-title">{{ section.settings.card1_title }}</h3>
        <p class="quick-order-choice__card-text">{{ section.settings.card1_text }}</p>
        <span class="quick-order-choice__card-btn">{{ section.settings.card1_btn }}</span>
      </a>

      <!-- Carte 2 : Commande Personnalisée -->
      <a href="{{ section.settings.card2_link }}" class="quick-order-choice__card quick-order-choice__card--2">
        <div class="quick-order-choice__card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="6" width="32" height="36" rx="3"/>
            <path d="M16 18h16M16 24h16M16 30h10"/>
            <path d="M33 31l2 2 4-4"/>
          </svg>
        </div>
        <h3 class="quick-order-choice__card-title">{{ section.settings.card2_title }}</h3>
        <p class="quick-order-choice__card-text">{{ section.settings.card2_text }}</p>
        <span class="quick-order-choice__card-btn">{{ section.settings.card2_btn }}</span>
      </a>

    </div>
  </div>
</div>

{% stylesheet %}
  .quick-order-choice {
    padding-block: 80px;
    padding-inline: var(--page-margin, 20px);
    background-color: var(--color-background);
  }

  .quick-order-choice__inner {
    max-width: 1100px;
    margin-inline: auto;
    text-align: center;
  }

  .quick-order-choice__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    margin-block-end: 12px;
    color: var(--color-foreground);
  }

  .quick-order-choice__subheading {
    font-size: 1.1rem;
    color: var(--color-foreground);
    opacity: 0.7;
    margin-block-end: 48px;
    max-width: 600px;
    margin-inline: auto;
  }

  .quick-order-choice__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;

    @media screen and (max-width: 749px) {
      grid-template-columns: 1fr;
    }
  }

  .quick-order-choice__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 32px;
    border: 2px solid var(--color-foreground);
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-foreground);
    background-color: var(--color-background);
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    cursor: pointer;
  }

  .quick-order-choice__card:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
  }

  .quick-order-choice__card-icon {
    width: 72px;
    height: 72px;
    margin-block-end: 24px;
  }

  .quick-order-choice__card-icon svg {
    width: 100%;
    height: 100%;
  }

  .quick-order-choice__card-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin-block-end: 16px;
    margin-block-start: 0;
  }

  .quick-order-choice__card-text {
    font-size: 1rem;
    line-height: 1.6;
    margin-block-end: 32px;
    opacity: 0.8;
    max-width: 340px;
  }

  .quick-order-choice__card-btn {
    display: inline-block;
    padding: 14px 32px;
    border: 2px solid currentColor;
    border-radius: 100px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
    margin-block-start: auto;
  }

  .quick-order-choice__card:hover .quick-order-choice__card-btn {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Choix de commande",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Palette de couleurs",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre de la section",
      "default": "Comment voulez-vous commander ?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Choisissez l'option qui correspond le mieux à vos besoins."
    },
    {
      "type": "header",
      "content": "Carte 1 — Commande Rapide"
    },
    {
      "type": "text",
      "id": "card1_title",
      "label": "Titre",
      "default": "Commande Rapide"
    },
    {
      "type": "textarea",
      "id": "card1_text",
      "label": "Description",
      "default": "Parcourez notre catalogue de vêtements standards et obtenez un prix instantané. Idéal si vous savez déjà ce que vous voulez."
    },
    {
      "type": "text",
      "id": "card1_btn",
      "label": "Texte du bouton",
      "default": "Voir le catalogue"
    },
    {
      "type": "url",
      "id": "card1_link",
      "label": "Lien"
    },
    {
      "type": "header",
      "content": "Carte 2 — Commande Personnalisée"
    },
    {
      "type": "text",
      "id": "card2_title",
      "label": "Titre",
      "default": "Commande Personnalisée"
    },
    {
      "type": "textarea",
      "id": "card2_text",
      "label": "Description",
      "default": "Vous avez un projet unique ou des exigences spécifiques ? Contactez-nous pour un devis personnalisé adapté à vos besoins."
    },
    {
      "type": "text",
      "id": "card2_btn",
      "label": "Texte du bouton",
      "default": "Demander un devis"
    },
    {
      "type": "url",
      "id": "card2_link",
      "label": "Lien"
    }
  ],
  "presets": [
    {
      "name": "Choix de commande"
    }
  ]
}
{% endschema %}
