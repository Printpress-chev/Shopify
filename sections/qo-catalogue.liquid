      <circle cx="50" cy="20" r="8" fill="none"/>
    </svg>`,

    cap: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 56 Q20 24 50 24 Q80 24 80 56 L80 66 L20 66 Z"/>
      <path d="M4 66 L80 66"/>
      <path d="M50 24 L50 42"/>
      <path d="M35 42 L65 42"/>
    </svg>`,

    default: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M35 12 Q50 6 65 12 L90 30 L76 40 L76 88 L24 88 L24 40 L10 30 Z"/>
      <path d="M35 12 Q43 22 50 22 Q57 22 65 12"/>
    </svg>`,
  };

  const ICON_KEYWORDS = {
    tshirt:     ['t-shirt','tshirt','tee','t shirt'],
    longsleeve: ['long sleeve','manche longue','longsleeve','long-sleeve'],
    hoodie:     ['hoodie','hoody','sweat à capuche','capuche','zip hoodie'],
    sweater:    ['sweater','sweatshirt','pull','crewneck','crew neck'],
    jacket:     ['jacket','veste','veston','manteau','coat'],
    polo:       ['polo'],
    bag:        ['bag','sac','tote'],
    beanie:     ['beanie','bonnet','tuque'],
    cap:        ['cap','casquette','hat','chapeau'],
  };

  // Load uploaded category images from blocks
  const blockIcons = [];
  const typeIconMap = {};
  try {
    JSON.parse(document.getElementById('qo-icons-data').textContent)
      .forEach(item => {
        blockIcons.push(item);
        if (item.url) typeIconMap[item.type] = item.url;
      });
  } catch(e) {}

  function getIcon(typeName) {
    const handle = typeName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    if (typeIconMap[handle]) {
      return `<img src="${typeIconMap[handle]}" alt="${typeName}" class="qo-type-img">`;
    }
    const lower = typeName.toLowerCase();
    for (const [key, keywords] of Object.entries(ICON_KEYWORDS)) {
      if (keywords.some(kw => lower.includes(kw))) return ICONS[key];
    }
    return ICONS.default;
  }

  /* ── Color map ─────────────────────────────────── */
  const COLOR_MAP = {
    'blanc':'#f5f5f5','white':'#f5f5f5','noir':'#111','black':'#111',
    'rouge':'#e53e3e','red':'#e53e3e','bleu':'#3b82f6','blue':'#3b82f6',
    'bleu ciel':'#87ceeb','sky blue':'#87ceeb','bleu marine':'#1a365d',
    'marine':'#1a365d','navy':'#1a365d','vert':'#16a34a','green':'#16a34a',
    'jaune':'#ecc94b','yellow':'#ecc94b','orange':'#f97316',
    'gris':'#9ca3af','grey':'#9ca3af','gray':'#9ca3af',
    'gris chiné':'#c4c4c4','heather grey':'#c4c4c4','rose':'#f472b6','pink':'#f472b6',
    'violet':'#7c3aed','purple':'#7c3aed','marron':'#92400e','brown':'#92400e',
    'beige':'#f5f0e1','kaki':'#8b7355','khaki':'#8b7355','bordeaux':'#9b1c1c',
    'burgundy':'#9b1c1c','turquoise':'#0d9488','corail':'#fb7185','coral':'#fb7185',
    'écru':'#f5f0e1','ecru':'#f5f0e1','anthracite':'#3d3d3d',
    'caramel':'#d97706','lavande':'#a78bfa','lavender':'#a78bfa',
  };

  function getColor(name) {
    return COLOR_MAP[name.toLowerCase().trim()] || name.toLowerCase().trim();
  }

  /* ── Size order ─────────────────────────────────── */
  const SIZE_ORDER = ['xxs','xs','s','m','l','xl','xxl','2xl','3xl','4xl','5xl','one size','taille unique','tu'];
  function sortSizes(arr) {
    return [...arr].sort((a, b) => {
      const ai = SIZE_ORDER.indexOf(a.toLowerCase()), bi = SIZE_ORDER.indexOf(b.toLowerCase());
      if (ai === -1 && bi === -1) return a.localeCompare(b);
      if (ai === -1) return 1; if (bi === -1) return -1;
      return ai - bi;
    });
  }

  /* ── Money format ───────────────────────────────── */
  function formatMoney(cents) {
    const amount = (cents / 100).toFixed(2);
    return window.qoCatConfig.moneyFormat
      .replace(/\{\{\s*amount\s*\}\}/g, amount)
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, Math.round(cents / 100))
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amount.replace('.', ','));
  }

  /* ── DOM refs ───────────────────────────────────── */
  const grid      = document.getElementById('qo-grid');
  const cards     = Array.from(grid.querySelectorAll('.qo-cat__card'));
  const countEl   = document.getElementById('qo-count');
  const heroQty   = document.getElementById('qo-hero-qty');
  const typesEl   = document.getElementById('qo-types');
  /* ── Collect unique filter values ───────────────── */
  const typeMap   = new Map(); // handleized → raw label
  const colorSet  = new Set();
  const sizeSet   = new Set();
  const printSet  = new Set();
  const vendorSet = new Set();

  cards.forEach(card => {
    const t = card.dataset.type, tr = card.dataset.typeRaw;
    if (t && tr) typeMap.set(t, tr);
    card.dataset.colors.split('|||').filter(Boolean).forEach(c => colorSet.add(c.trim()));
    card.dataset.sizes.split('|||').filter(Boolean).forEach(s => sizeSet.add(s.trim()));
    card.dataset.print.split('|||').filter(Boolean).forEach(p => printSet.add(p.trim()));
    if (card.dataset.vendor) vendorSet.add(card.dataset.vendor.trim());
  });

  /* ── Build Step 2 type icons ────────────────────── */
  if (blockIcons.length > 0) {
    // Use admin-configured icons from blocks
    blockIcons.forEach(item => {
      const btn = document.createElement('button');
      btn.className = 'qo-type-btn';
      btn.dataset.type = item.type;
      btn.type = 'button';
      const iconHtml = item.url
        ? `<img src="${item.url}" alt="${item.label}" class="qo-type-img">`
        : getIcon(item.label);
      btn.innerHTML = `${iconHtml}<span class="qo-type-btn__label">${item.label}</span>`;
      btn.addEventListener('click', () => selectType(item.type, btn));
      typesEl.appendChild(btn);
    });
  } else {
    // Fallback: build from product types found in the grid
    typeMap.forEach((rawLabel, handleized) => {
      const btn = document.createElement('button');
      btn.className = 'qo-type-btn';
      btn.dataset.type = handleized;
      btn.type = 'button';
      btn.innerHTML = `${getIcon(rawLabel)}<span class="qo-type-btn__label">${rawLabel}</span>`;
      btn.addEventListener('click', () => selectType(handleized, btn));
      typesEl.appendChild(btn);
    });
  }

  let activeType = '';

  const step3TypeEl = document.getElementById('qo-step3-type');

  function selectType(handleized, btn) {
    if (activeType === handleized) {
      activeType = '';
      typesEl.querySelectorAll('.qo-type-btn').forEach(b => b.classList.remove('is-active'));
      if (step3TypeEl) step3TypeEl.textContent = 'PRODUIT';
    } else {
      activeType = handleized;
      typesEl.querySelectorAll('.qo-type-btn').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const label = btn.querySelector('.qo-type-btn__label');
      if (step3TypeEl) step3TypeEl.textContent = label ? label.textContent.toUpperCase() : handleized.toUpperCase();
    }

    applyFilters();

    // Smooth scroll to grid
    document.getElementById('qo-step3').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ── Populate secondary filter selects ─────────── */
  function addOptions(selectId, values, labelFn) {
    const sel = document.getElementById(selectId);
    if (!sel) return;
    values.forEach(val => {
      const opt = document.createElement('option');
      opt.value = val;
      opt.textContent = labelFn ? labelFn(val) : val;
      sel.appendChild(opt);
    });
  }

  // Capitalize each word of a color name
  function titleCase(s) {
    return s.replace(/\b\w/g, c => c.toUpperCase());
  }

  // Color families — regroupe les teintes proches en une seule pastille
  const COLOR_FAMILIES = [
    { key: 'blanc',        label: 'Blanc',         hex: '#f2f2f2', border: '#ccc', keywords: ['blanc','white','écru','ecru','ivoire','ivory','crème','cream','sable','sand','naturel','natural','off-white'] },
    { key: 'beige',        label: 'Beige',          hex: '#d4b896', keywords: ['beige','taupe','camel','tan','stone','pierre'] },
    { key: 'gris',         label: 'Gris',           hex: '#9ca3af', keywords: ['gris','grey','gray','anthracite','chiné','heather','silver','argent','mélange'] },
    { key: 'noir',         label: 'Noir',           hex: '#111',    keywords: ['noir','black','onyx','charbon','charcoal'] },
    { key: 'bleu',         label: 'Bleu',           hex: '#3b82f6', keywords: ['bleu','blue','marine','navy','indigo','cobalt','ciel','sky','turquoise','aqua','canard','denim','saphir','sapphire','azure'] },
    { key: 'vert',         label: 'Vert',           hex: '#16a34a', keywords: ['vert','green','kaki','khaki','olive','sauge','sage','forêt','forest','menthe','mint','émeraude','emerald','militaire'] },
    { key: 'rouge',        label: 'Rouge',          hex: '#e53e3e', keywords: ['rouge','red','bordeaux','burgundy','corail','coral','tomate','tomato','framboise','cramoisi','crimson','rubis','ruby'] },
    { key: 'rose',         label: 'Rose',           hex: '#f9a8d4', border: '#e0b0c0', keywords: ['rose','pink','blush','fuchsia','magenta'] },
    { key: 'violet',       label: 'Violet',         hex: '#7c3aed', keywords: ['violet','purple','lavande','lavender','mauve','lilas','lilac','prune','plum','aubergine'] },
    { key: 'jaune',        label: 'Jaune',          hex: '#ecc94b', border: '#d4a800', keywords: ['jaune','yellow','moutarde','mustard','citron','safran','saffron','doré','gold','miel','honey'] },
    { key: 'orange',       label: 'Orange',         hex: '#f97316', keywords: ['orange','corail','coral','pêche','peach','saumon','salmon','rouille','rust','terracotta','caramel'] },
    { key: 'marron',       label: 'Marron',         hex: '#92400e', keywords: ['marron','brown','brun','chocolat','chocolate','café','coffee','noisette','cognac','rouille','rust','terracotta'] },
  ];

  function getFamilyForColor(colorVal) {
    const lower = colorVal.toLowerCase().trim();
    for (const fam of COLOR_FAMILIES) {
      if (fam.keywords.some(kw => lower.includes(kw))) return fam.key;
    }
    return null;
  }

  // Build color swatches panel (one swatch per family present in catalog)
  let activeColor = ''; // stores a family key
  const colorPanelEl   = document.getElementById('qo-panel-color');
  const colorSwatchesEl = document.getElementById('qo-color-swatches');
  const colorTitleEl   = colorPanelEl ? colorPanelEl.querySelector('.qo-panel-filter__title') : null;
  const colorTriggerEl = colorPanelEl ? colorPanelEl.querySelector('.qo-panel-filter__trigger') : null;

  // Which families actually exist in the catalog?
  const presentFamilies = new Set();
  colorSet.forEach(c => { const f = getFamilyForColor(c); if (f) presentFamilies.add(f); });

  if (presentFamilies.size > 0 && colorPanelEl) {
    COLOR_FAMILIES.filter(f => presentFamilies.has(f.key)).forEach(fam => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'qo-color-swatch';
      btn.dataset.color = fam.key;
      btn.title = fam.label;
      btn.style.background = fam.hex;
      if (fam.border) btn.style.borderColor = fam.border;
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (activeColor === fam.key) {
          activeColor = '';
          btn.classList.remove('is-active');
          colorPanelEl.classList.remove('is-active');
          if (colorTitleEl) colorTitleEl.textContent = 'Couleur';
        } else {
          activeColor = fam.key;
          colorSwatchesEl.querySelectorAll('.qo-color-swatch').forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          colorPanelEl.classList.add('is-active');
          if (colorTitleEl) colorTitleEl.textContent = fam.label;
        }
        closeAllPanels(colorPanelEl);
        applyFilters();
      });
      colorSwatchesEl.appendChild(btn);
    });

    colorTriggerEl.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = colorPanelEl.classList.contains('is-open');
      closeAllPanels();
      if (!isOpen) colorPanelEl.classList.add('is-open');
    });
  } else if (colorPanelEl) {
    colorPanelEl.classList.add('is-hidden');
  }

  /* ── Panel filters ──────────────────────────────── */
  const panelFilters = {}; // { sizes: '', vendor: '', print: '' }

  function buildPanel(panelId, values, labelFn) {
    const wrapper = document.getElementById(panelId);
    if (!wrapper) return;
    if (values.length === 0) { wrapper.classList.add('is-hidden'); return; }

    const filterKey = wrapper.dataset.filter;
    panelFilters[filterKey] = '';

    const list = wrapper.querySelector('.qo-panel-filter__list');
    const trigger = wrapper.querySelector('.qo-panel-filter__trigger');
    const titleEl = wrapper.querySelector('.qo-panel-filter__title');
    const defaultLabel = titleEl.textContent;

    values.forEach(val => {
      const label = labelFn ? labelFn(val) : val;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'qo-panel-item';
      btn.dataset.value = val;
      btn.textContent = label;
      btn.addEventListener('click', () => {
        const isActive = btn.classList.contains('is-active');
        list.querySelectorAll('.qo-panel-item').forEach(b => b.classList.remove('is-active'));
        if (isActive) {
          panelFilters[filterKey] = '';
          wrapper.classList.remove('is-active');
          titleEl.textContent = defaultLabel;
        } else {
          btn.classList.add('is-active');
          panelFilters[filterKey] = val;
          wrapper.classList.add('is-active');
          titleEl.textContent = label;
        }
        closeAllPanels(wrapper);
        applyFilters();
      });
      list.appendChild(btn);
    });

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = wrapper.classList.contains('is-open');
      closeAllPanels();
      if (!isOpen) wrapper.classList.add('is-open');
    });
  }

  function closeAllPanels(except) {
    document.querySelectorAll('.qo-panel-filter').forEach(p => {
      if (p !== except) p.classList.remove('is-open');
    });
  }

  document.addEventListener('click', () => closeAllPanels());

  buildPanel('qo-panel-size',   sortSizes([...sizeSet]));
  buildPanel('qo-panel-vendor', [...vendorSet].sort(), titleCase);
  buildPanel('qo-panel-print',  [...printSet].sort(), v =>
    v.replace(/^print_/i, '').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
  );

  /* ── Filter logic ───────────────────────────────── */
  function applyFilters() {
    const active = {};
    if (activeType)  active.type   = activeType;
    if (activeColor) active.colors = activeColor;
    Object.entries(panelFilters).forEach(([k, v]) => { if (v) active[k] = v; });

    let visible = 0;
    cards.forEach(card => {
      let show = true;
      for (const [filter, value] of Object.entries(active)) {
        if (filter === 'type') {
          if (card.dataset.type !== value) { show = false; break; }
        } else if (filter === 'colors') {
          // Match by family: at least one product color must belong to the selected family
          const productColors = (card.dataset.colors || '').split('|||').map(c => c.trim().toLowerCase()).filter(Boolean);
          const match = productColors.some(c => getFamilyForColor(c) === value);
          if (!match) { show = false; break; }
        } else if (filter === 'vendor') {
          if ((card.dataset.vendor || '').toLowerCase() !== value.toLowerCase()) { show = false; break; }
        } else {
          const raw = card.dataset[filter] || '';
          const vals = raw.split('|||').map(v => v.trim().toLowerCase()).filter(Boolean);
          if (vals.length === 0 || !vals.includes(value.toLowerCase())) { show = false; break; }
        }
      }
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    countEl.textContent = `${visible} produit${visible !== 1 ? 's' : ''}`;
  }

  document.getElementById('qo-reset').addEventListener('click', () => {
    Object.keys(panelFilters).forEach(k => {
      panelFilters[k] = '';
      const wrapper = document.querySelector(`.qo-panel-filter[data-filter="${k}"]`);
      if (wrapper) {
        wrapper.classList.remove('is-active');
        wrapper.querySelectorAll('.qo-panel-item').forEach(b => b.classList.remove('is-active'));
        const titleEl = wrapper.querySelector('.qo-panel-filter__title');
        const defaultLabels = { sizes: 'Taille', vendor: 'Fournisseur', print: "Type d'impression" };
        if (titleEl) titleEl.textContent = defaultLabels[k] || k;
      }
    });
    activeType  = '';
    activeColor = '';
    colorSwatchesEl.querySelectorAll('.qo-color-swatch').forEach(b => b.classList.remove('is-active'));
    if (colorPanelEl) { colorPanelEl.classList.remove('is-active'); }
    if (colorTitleEl) colorTitleEl.textContent = 'Couleur';
    typesEl.querySelectorAll('.qo-type-btn').forEach(b => b.classList.remove('is-active'));
    applyFilters();
  });

  applyFilters();

  /* ── Modal ──────────────────────────────────────── */
  const modal      = document.getElementById('qo-modal');
  const backdrop   = document.getElementById('qo-backdrop');
  const closeBtn   = document.getElementById('qo-modal-close');
  const modalBody  = document.getElementById('qo-modal-body');
  const modalActions = document.getElementById('qo-modal-actions');
  const modalImg   = document.getElementById('qo-modal-img');
  const imgPrev    = document.getElementById('qo-img-prev');
  const imgNext    = document.getElementById('qo-img-next');
  const colorBar   = document.getElementById('qo-modal-color-bar');
  let   imgIndex   = 0;

  let currentProduct  = null;
  let selectedOptions = {};

  function openModal(productId) {
    const card   = grid.querySelector(`[data-product="${productId}"]`);
    const dataEl = card.querySelector('.qo-product-data');
    currentProduct  = JSON.parse(dataEl.textContent);
    selectedOptions = {};
    renderModal();
    modal.classList.add('is-open');
    backdrop.classList.add('is-open');
    document.body.classList.add('qo-modal-open');
  }

  function closeModal() {
    modal.classList.remove('is-open');
    backdrop.classList.remove('is-open');
    document.body.classList.remove('qo-modal-open');
  }

  function showImg(index) {
    const imgs = currentProduct.images;
    if (!imgs || imgs.length === 0) return;
    imgIndex = Math.max(0, Math.min(index, imgs.length - 1));
    modalImg.src = imgs[imgIndex];
    imgPrev.classList.toggle('is-hidden', imgIndex === 0);
    imgNext.classList.toggle('is-hidden', imgIndex >= imgs.length - 1);
  }

  imgPrev.addEventListener('click', () => showImg(imgIndex - 1));
  imgNext.addEventListener('click', () => showImg(imgIndex + 1));

  function renderModal() {
    const p   = currentProduct;
    const qty = parseInt(heroQty.value) || MIN_QTY;

    const colorOption  = p.options.find(o => ['couleur','color','colour'].includes(o.name.toLowerCase()));
    const sizeOption   = p.options.find(o => ['taille','size'].includes(o.name.toLowerCase()));
    const otherOptions = p.options.filter(o => o !== colorOption && o !== sizeOption);

    const priceHtml = p.price_min !== p.price_max
      ? `À partir de ${formatMoney(p.price_min)}`
      : formatMoney(p.price_min);

    // Image
    imgIndex = 0;
    showImg(0);
    modalImg.alt = p.title;

    // Barre couleurs
    if (p.color_count > 0) {
      colorBar.textContent = `Available in ${p.color_count} colour${p.color_count > 1 ? 's' : ''}`;
      colorBar.style.display = '';
    } else {
      colorBar.style.display = 'none';
    }

    // Corps : type + titre + description
    let bodyHtml = `
      ${p.type ? `<p class="qo-modal__type">${p.type}</p>` : ''}
      <h2 class="qo-modal__title">${p.title}</h2>
      ${p.description ? `<div class="qo-modal__desc">${p.description}</div>` : ''}
    `;
    modalBody.innerHTML = bodyHtml;

    // Actions : options + qty + ATC
    let actHtml = `<p class="qo-modal__price" id="qo-modal-price">${priceHtml} <span>/ pièce</span></p><hr class="qo-modal__divider">`;

    if (colorOption) {
      // Construire map couleur → URL swatch depuis les variantes
      const swatchMap = {};
      p.variants.forEach(v => {
        if (v.option1 && v.swatch && !swatchMap[v.option1]) {
          swatchMap[v.option1] = v.swatch;
        }
      });

      actHtml += `
        <div class="qo-modal__option-group">
          <p class="qo-modal__option-label">${colorOption.name} <span class="qo-modal__option-selected" id="qo-color-label"></span></p>
          <div class="qo-modal__swatches" id="qo-opt-${colorOption.name}">
            ${colorOption.values.map(val => {
              const swatchUrl = swatchMap[val];
              const inner = swatchUrl
                ? `<img src="${swatchUrl}" alt="${val}" loading="lazy">`
                : `<span style="display:block;width:100%;height:100%;background:${getColor(val)};border-radius:50%;"></span>`;
              return `<button class="qo-modal__swatch-btn" data-option="${colorOption.name}" data-value="${val}" title="${val}" type="button">${inner}</button>`;
            }).join('')}
          </div>
        </div>`;
    }

    if (sizeOption) {
      actHtml += `
        <div class="qo-modal__option-group">
          <p class="qo-modal__option-label">${sizeOption.name}</p>
          <div class="qo-modal__sizes">
            ${sortSizes(sizeOption.values).map(val => `<button class="qo-modal__size-btn" data-option="${sizeOption.name}" data-value="${val}" type="button">${val}</button>`).join('')}
          </div>
        </div>`;
    }

    otherOptions.forEach(option => {
      actHtml += `
        <div class="qo-modal__option-group">
          <p class="qo-modal__option-label">${option.name}</p>
          <div class="qo-modal__sizes">
            ${option.values.map(val => `<button class="qo-modal__size-btn" data-option="${option.name}" data-value="${val}" type="button">${val}</button>`).join('')}
          </div>
        </div>`;
    });

    actHtml += `
      <div class="qo-modal__qty-group">
        <p class="qo-modal__option-label">Quantité <span class="qo-modal__qty-min">(min. ${MIN_QTY} pièces)</span></p>
        <div class="qo-modal__qty-wrap">
          <button class="qo-modal__qty-btn" id="qo-qty-dec" type="button">−</button>
          <input class="qo-modal__qty-input" id="qo-qty-input" type="number" value="${Math.max(qty, MIN_QTY)}" min="${MIN_QTY}" step="1">
          <button class="qo-modal__qty-btn" id="qo-qty-inc" type="button">+</button>
        </div>
      </div>
      <button class="qo-modal__atc" id="qo-atc" type="button">Ajouter au panier</button>
      <p class="qo-modal__feedback" id="qo-feedback"></p>
    `;

    modalActions.innerHTML = actHtml;

    /* Option events */
    modalActions.querySelectorAll('[data-option]').forEach(btn => {
      btn.addEventListener('click', () => {
        const optName = btn.dataset.option;
        const val     = btn.dataset.value;
        selectedOptions[optName] = val;

        const group = btn.closest('.qo-modal__swatches, .qo-modal__sizes');
        group.querySelectorAll('[data-option]').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        if (['couleur','color','colour'].includes(optName.toLowerCase())) {
          const lbl = document.getElementById('qo-color-label');
          if (lbl) lbl.textContent = val;
        }

        updateVariantState();
      });
    });

    /* Quantity */
    const qtyInput = document.getElementById('qo-qty-input');
    document.getElementById('qo-qty-dec').addEventListener('click', () => {
      qtyInput.value = Math.max(MIN_QTY, parseInt(qtyInput.value) - 1);
    });
    document.getElementById('qo-qty-inc').addEventListener('click', () => {
      qtyInput.value = parseInt(qtyInput.value) + 1;
    });
    qtyInput.addEventListener('change', () => {
      if (parseInt(qtyInput.value) < MIN_QTY) qtyInput.value = MIN_QTY;
    });

    document.getElementById('qo-atc').addEventListener('click', addToCart);
  }

  function findVariant() {
    if (!currentProduct) return null;
    return currentProduct.variants.find(v =>
      currentProduct.options.every((opt, i) => {
        const sel = selectedOptions[opt.name];
        if (!sel) return true;
        return (v[`option${i + 1}`] || '').toLowerCase() === sel.toLowerCase();
      })
    );
  }

  function updateVariantState() {
    const variant    = findVariant();
    const atcBtn     = document.getElementById('qo-atc');
    if (!atcBtn) return;
    const allSelected = currentProduct.options.every(opt => selectedOptions[opt.name]);

    if (!allSelected || !variant) {
      atcBtn.disabled = false;
      atcBtn.textContent = 'Ajouter au panier';
    } else if (!variant.available) {
      atcBtn.disabled = true;
      atcBtn.textContent = 'Rupture de stock';
    } else {
      atcBtn.disabled = false;
      atcBtn.textContent = 'Ajouter au panier';
    }
  }

  async function addToCart() {
    const allSelected = currentProduct.options.every(opt => selectedOptions[opt.name]);
    if (!allSelected) { showFeedback('Veuillez sélectionner toutes les options.', 'error'); return; }

    const variant = findVariant();
    if (!variant) { showFeedback("Cette combinaison n'est pas disponible.", 'error'); return; }

    const qty = parseInt(document.getElementById('qo-qty-input').value);
    if (qty < MIN_QTY) { showFeedback(`Minimum ${MIN_QTY} pièces requis.`, 'error'); return; }

    const atcBtn = document.getElementById('qo-atc');
    atcBtn.disabled = true;
    atcBtn.textContent = 'Ajout en cours…';
    document.getElementById('qo-feedback').textContent = '';

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variant.id, quantity: qty }] })
      });
      if (!res.ok) { const e = await res.json(); throw new Error(e.description || 'Erreur'); }

      atcBtn.textContent = '✓ Ajouté !';
      showFeedback('Produit ajouté au panier avec succès !', 'success');

      // Update header cart count
      fetch('/cart.js').then(r => r.json()).then(data => {
        document.querySelectorAll('[data-cart-count], .qo-cart-count').forEach(el => {
          el.textContent = data.item_count;
        });
      }).catch(() => {});

      setTimeout(closeModal, 1400);
    } catch (e) {
      showFeedback(e.message || 'Une erreur est survenue.', 'error');
      atcBtn.disabled = false;
      atcBtn.textContent = 'Ajouter au panier';
    }
  }

  function showFeedback(msg, type) {
    const el = document.getElementById('qo-feedback');
    if (!el) return;
    el.textContent = msg;
    el.className = `qo-modal__feedback qo-modal__feedback--${type}`;
  }

  /* ── Event listeners ────────────────────────────── */
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // Info buttons open modal
  grid.addEventListener('click', e => {
    const infoBtn = e.target.closest('.qo-cat__info-btn');
    if (infoBtn) { e.stopPropagation(); openModal(infoBtn.dataset.product); return; }
    // Clicking the card itself goes to product page
    const card = e.target.closest('.qo-cat__card');
    if (card && card.dataset.handle) {
      const qty = parseInt(heroQty?.value) || MIN_QTY;
      window.location.href = `/products/${card.dataset.handle}?quantity=${qty}`;
    }
  });

  /* Pre-fill qty from URL ?quantity param */
  const urlQty = parseInt(new URLSearchParams(window.location.search).get('quantity'));
  if (heroQty && urlQty >= MIN_QTY) {
    heroQty.value = urlQty;
  }

  /* Update all product links when hero qty changes */
  function updateProductLinks() {
    const qty = parseInt(heroQty.value) || MIN_QTY;
    document.querySelectorAll('[data-handle]').forEach(link => {
      link.href = `/products/${link.dataset.handle}?quantity=${qty}`;
    });
  }

  if (heroQty) {
    heroQty.addEventListener('input', () => {
      updateProductLinks();
    });
    heroQty.addEventListener('change', () => {
      if (parseInt(heroQty.value) < MIN_QTY) heroQty.value = MIN_QTY;
      updateProductLinks();
    });
  }

})();
</script>

