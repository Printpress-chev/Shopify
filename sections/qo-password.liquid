<div class="qo-pw">

  <!-- Logo -->
  <div class="qo-pw__logo">
    {%- if section.settings.logo != blank -%}
      <img
        src="{{ section.settings.logo | image_url: width: 300 }}"
        alt="{{ shop.name }}"
        class="qo-pw__logo-img"
      >
    {%- else -%}
      <p class="qo-pw__logo-text">{{ shop.name }}</p>
    {%- endif -%}
  </div>

  <!-- Message -->
  <div class="qo-pw__content">
    <h1 class="qo-pw__title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="qo-pw__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <!-- Divider -->
  <div class="qo-pw__divider"></div>

  <!-- Zoho form (JS embed) -->
  <div class="qo-pw__form-wrap">
    <h2 class="qo-pw__form-title">{{ section.settings.form_title }}</h2>
    <div id="zf_div_JIemBrsTTxF4LMTpTYFKZRkkrdRG7Ui-zfi6YpoM3Bo"></div>
    <script type="text/javascript">
    (function() {
      try{
        var f = document.createElement("iframe");
        var ifrmSrc = 'https://forms.zohopublic.ca/printpress1/form/Demandedesoumission/formperma/JIemBrsTTxF4LMTpTYFKZRkkrdRG7Ui-zfi6YpoM3Bo?zf_rszfm=1&zf_enablecamera=true';
        f.src = ifrmSrc;
        f.style.border = "none";
        f.style.height = "4544px";
        f.style.width = "100%";
        f.style.transition = "all 0.5s ease";
        f.setAttribute("aria-label", 'Demande de soumission');
        f.setAttribute("allow", "camera;");
        var d = document.getElementById("zf_div_JIemBrsTTxF4LMTpTYFKZRkkrdRG7Ui-zfi6YpoM3Bo");
        d.appendChild(f);
        window.addEventListener('message', function(event){
          var evntData = event.data;
          if(evntData && evntData.constructor == String){
            var zf_ifrm_data = evntData.split("|");
            if(zf_ifrm_data.length == 2 || zf_ifrm_data.length == 3){
              var zf_perma = zf_ifrm_data[0];
              var zf_ifrm_ht_nw = (parseInt(zf_ifrm_data[1], 10) + 15) + "px";
              var iframe = document.getElementById("zf_div_JIemBrsTTxF4LMTpTYFKZRkkrdRG7Ui-zfi6YpoM3Bo").getElementsByTagName("iframe")[0];
              if((iframe.src).indexOf('formperma') > 0 && (iframe.src).indexOf(zf_perma) > 0){
                var prevIframeHeight = iframe.style.height;
                var zf_tout = false;
                if(zf_ifrm_data.length == 3){
                  iframe.scrollIntoView();
                  zf_tout = true;
                }
                if(prevIframeHeight != zf_ifrm_ht_nw){
                  if(zf_tout){
                    setTimeout(function(){ iframe.style.height = zf_ifrm_ht_nw; }, 500);
                  } else {
                    iframe.style.height = zf_ifrm_ht_nw;
                  }
                }
              }
            }
          }
        }, false);
      }catch(e){}
    })();
    </script>
  </div>

  <!-- Footer -->
  <div class="qo-pw__footer">
    <p>{{ section.settings.contact }}</p>
    <!-- Link to enter password (Shopify built-in) -->
    <button class="qo-pw__enter-btn" onclick="document.getElementById('password-form').querySelector('dialog').showModal()">
      Accès administrateur
    </button>
  </div>

</div>

{% stylesheet %}

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    min-height: 100vh;
  }

  .qo-pw {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    gap: 32px;
    background: #fff;
  }

  /* Logo */
  .qo-pw__logo { text-align: center; }

  .qo-pw__logo-img {
    height: 60px;
    width: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  .qo-pw__logo-text {
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C9A96E;
  }

  /* Message */
  .qo-pw__content { text-align: center; }

  .qo-pw__title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #111;
    line-height: 1.1;
    margin-bottom: 14px;
  }

  .qo-pw__title span { color: #C9A96E; }

  .qo-pw__subtitle {
    font-size: 1rem;
    color: rgba(0,0,0,0.55);
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto;
  }

  /* Divider */
  .qo-pw__divider {
    width: 60px;
    height: 3px;
    background: #C9A96E;
    border-radius: 2px;
  }

  /* Zoho form */
  .qo-pw__form-wrap {
    width: 100%;
    max-width: 680px;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    border-radius: 16px;
    overflow: hidden;
    padding: 32px 28px;
  }

  .qo-pw__form-title {
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C9A96E;
    margin-bottom: 20px;
    text-align: center;
  }

  .qo-pw__iframe {
    width: 100%;
    height: 620px;
    border: none;
    display: block;
    background: transparent;
  }

  /* Footer */
  .qo-pw__footer {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .qo-pw__footer p {
    font-size: 0.82rem;
    color: rgba(0,0,0,0.35);
  }

  .qo-pw__enter-btn {
    background: none;
    border: none;
    font-size: 0.75rem;
    color: rgba(0,0,0,0.2);
    cursor: pointer;
    text-decoration: underline;
    padding: 4px;
    transition: color 0.2s;
  }

  .qo-pw__enter-btn:hover { color: rgba(0,0,0,0.5); }

  /* Password dialog (Shopify built-in, restyle) */
  .password-dialog {
    border: 1px solid #ddd;
    border-radius: 12px;
    background: #fff;
    color: #111;
    padding: 32px;
    max-width: 380px;
    width: 90%;
  }

  @media (max-width: 600px) {
    .qo-pw__form-wrap { padding: 20px 16px; }
    .qo-pw__iframe    { height: 520px; }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "QO — Page en construction",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre principal",
      "default": "Site en construction"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre / message",
      "default": "Nous travaillons fort pour vous offrir la meilleure expérience. En attendant, soumettez votre demande de soumission ci-dessous."
    },
    {
      "type": "header",
      "content": "Formulaire Zoho"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Titre du formulaire",
      "default": "Demande de soumission"
    },
    {
      "type": "header",
      "content": "Pied de page"
    },
    {
      "type": "text",
      "id": "contact",
      "label": "Texte de contact",
      "default": "info@printpress.store"
    }
  ],
  "presets": [{ "name": "QO — Page en construction" }]
}
{% endschema %}
