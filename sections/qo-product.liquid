    'heather irish green':'#388050','heather sport dark green':'#284838',
    'prairie dust/coyote brown':'#9a8050','coyote brown':'#9a8050',
    'antique sapphire':'#186070','tropical blue':'#005888','kelly mist':'#389050',
    'antique irish green':'#185830','heather green':'#388058',
    'forest green':'#1c4828','dune mist':'#908878','caribbean mist':'#389090',
    'galapagos blue':'#007080','antique jade dome':'#006048',
    'kelly green':'#008848','irish green':'#009040',
    'heather dark green':'#284038','brown savana':'#886038',
    'sapphire':'#1660a0','seafoam':'#58a098','sport dark green':'#24402a',
    'dark chocolate':'#281508',
    // ── Gildan — Gris / Noirs / Neutres ──
    'ice grey':'#e8e4e0','ash grey':'#c0bab4','slate':'#9a8888',
    'sport grey':'#9a9490','cement':'#888680','paragon':'#a08090',
