    'heather grey':'#a0a098','charcoal':'#3c3c3c','dark heather':'#383838',
    'graphite heather':'#4c4c4c','pitch black':'#0a0a0a','smoke':'#282828',
    'tweed':'#282820','pitch black mist':'#1a1a1a','black':'#111111',
  };

  // Parse customizer color map and merge
  const COLOR_MAP = { ...COLOR_MAP_BASE };
  const customColors = `{{ section.settings.color_map }}`;
  customColors.split('\n').forEach(line => {
    const [name, hex] = line.split('=');
    if (name && hex) COLOR_MAP[name.trim().toLowerCase()] = hex.trim();
  });

  function getCssColor(name) {
    const key = name.toLowerCase().trim();
    if (COLOR_MAP[key]) return COLOR_MAP[key];
    // Partial match: check if the name contains a known keyword
    for (const [k, v] of Object.entries(COLOR_MAP)) {
      if (key.includes(k) || k.includes(key)) return v;
    }
    return '#cccccc';
  }

  function isLight(css) {
    return ['#f5f5f5','#f8f4e8','#fff8e7','#f5f0e1','#e8d5b7','#f0e6d3','#f9c5d1','#d1d5db'].includes(css);
  }

  /* Size order */
  const SIZE_ORDER = ['xxs','xs','s','m','l','xl','xxl','2xl','3xl','4xl','5xl','one size','taille unique','tu'];
  const SIZE_CM   = { 's':35,'m':38,'l':41,'xl':44,'2xl':48,'xxl':48,'3xl':51,'4xl':54,'xs':32 };
  const SIZE_INCH = {};
  Object.keys(SIZE_CM).forEach(k => SIZE_INCH[k] = (SIZE_CM[k] / 2.54).toFixed(1));

  function sortSizes(arr) {
    return [...arr].sort((a,b) => {
      const ai = SIZE_ORDER.indexOf(a.toLowerCase()), bi = SIZE_ORDER.indexOf(b.toLowerCase());
      if (ai === -1 && bi === -1) return a.localeCompare(b);
      if (ai === -1) return 1; if (bi === -1) return -1;
      return ai - bi;
    });
  }

  /* Parse options */
  const colorOption = data.options_with_values.find(o => {
    const n = o.name.toLowerCase();
    return n.includes('color') || n.includes('colour') || n.includes('couleur');
  });
  const sizeOption = data.options_with_values.find(o => {
    const n = o.name.toLowerCase();
    return n.includes('size') || n.includes('taille');
  });

  const colors = colorOption ? colorOption.values : [];
  const sizes  = sizeOption  ? sortSizes(sizeOption.values) : [];

  /* Step 1 title update */
  const step1Type = document.getElementById('qo-step1-type');
  if (step1Type && data.type) {
    step1Type.textContent = data.type.toUpperCase() + ' COULEUR(S)';
  }

  /* Size guide */
  const sgSizesRow = document.getElementById('qo-sg-sizes-row');
  const sgCmRow    = document.getElementById('qo-sg-cm-row');
  let unitIsCm = true;
  if (sgSizesRow && sgCmRow && sizes.length > 0) {
    sizes.forEach(s => {
      const th = document.createElement('th');
      th.textContent = s.toUpperCase();
      sgSizesRow.appendChild(th);
      const td = document.createElement('td');
      td.dataset.size = s.toLowerCase();
      td.textContent = SIZE_CM[s.toLowerCase()] ?? '—';
      sgCmRow.appendChild(td);
    });

    // Unit toggle
    const toggleBtn  = document.getElementById('qo-unit-toggle');
    const unitLabel  = document.getElementById('qo-unit-label');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        unitIsCm = !unitIsCm;
        unitLabel.textContent  = unitIsCm ? 'EN CM' : 'EN POUCES';
        toggleBtn.textContent  = unitIsCm ? 'Afficher en pouces' : 'Afficher en cm';
        sgCmRow.querySelectorAll('td').forEach(td => {
          const map = unitIsCm ? SIZE_CM : SIZE_INCH;
          td.textContent = map[td.dataset.size] ?? '—';
        });
      });
    }
  }

  /* Find variant */
  function findVariant(color, size) {
    return data.variants.find(v => {
      let match = true;
      if (colorOption && color) {
        const val = v[`option${colorOption.position}`];
        if (!val || val.toLowerCase() !== color.toLowerCase()) match = false;
      }
      if (sizeOption && size) {
        const val = v[`option${sizeOption.position}`];
        if (!val || val.toLowerCase() !== size.toLowerCase()) match = false;
      }
      return match;
    });
  }

  /* Target qty from URL */
  const urlParams = new URLSearchParams(window.location.search);
  const targetQty = parseInt(urlParams.get('quantity')) || 0;
  if (targetQty >= 1) {
    const el = document.getElementById('qo-target');
    if (el) { el.style.display = 'flex'; document.getElementById('qo-target-qty').textContent = targetQty; }
  }

  /* Image gallery */
  const mainImg  = document.getElementById('qo-main-img');
  const thumbsEl = document.getElementById('qo-thumbs');
  if (thumbsEl) {
    thumbsEl.addEventListener('click', e => {
      const thumb = e.target.closest('.qo-prod__thumb');
      if (!thumb) return;
      thumbsEl.querySelectorAll('.qo-prod__thumb').forEach(t => t.classList.remove('is-active'));
      thumb.classList.add('is-active');
      if (mainImg) { mainImg.style.opacity='0.6'; mainImg.src=thumb.dataset.src; mainImg.onload=()=>mainImg.style.opacity='1'; }
    });
  }

  /* Build swatches (circles) */
  const swatchesEl = document.getElementById('qo-swatches');
  const selectedColors = new Set();

  /* ── Rich swatch tooltip ── */
  const swatchTooltip = document.createElement('div');
  swatchTooltip.className = 'qo-swatch-tooltip';
  swatchTooltip.innerHTML = '<span class="qo-swatch-tooltip__color"></span><p class="qo-swatch-tooltip__name"></p>';
  document.body.appendChild(swatchTooltip);
  const tooltipColor = swatchTooltip.querySelector('.qo-swatch-tooltip__color');
  const tooltipName  = swatchTooltip.querySelector('.qo-swatch-tooltip__name');
  let tooltipShowTimer, tooltipHideTimer;

  function showSwatchTooltip(btn, color, css) {
    clearTimeout(tooltipHideTimer);
    // Wait 2 seconds before showing
    tooltipShowTimer = setTimeout(() => {
      tooltipColor.style.background = css;
      tooltipName.textContent = color.toUpperCase();
      const rect = btn.getBoundingClientRect();
      const ttW = 150, ttH = 120;
      let left = rect.left + rect.width / 2 - ttW / 2;
      let top  = rect.top - ttH - 10;
      if (left < 8) left = 8;
      if (left + ttW > window.innerWidth - 8) left = window.innerWidth - ttW - 8;
      if (top < 8) top = rect.bottom + 10;
      swatchTooltip.style.left = left + 'px';
      swatchTooltip.style.top  = top + 'px';
      // Reset animation
      swatchTooltip.classList.remove('is-visible');
      void swatchTooltip.offsetWidth; // force reflow
      swatchTooltip.classList.add('is-visible');
    }, 2000);
  }

  function hideSwatchTooltip() {
    clearTimeout(tooltipShowTimer);
    swatchTooltip.classList.remove('is-visible');
  }

  function buildSwatches() {
    if (!swatchesEl) return;
    if (colors.length === 0) {
      swatchesEl.innerHTML = '<p style="font-size:0.8rem;color:rgba(255,255,255,0.4)">Pas d\'option couleur</p>';
      return;
    }
    colors.forEach(color => {
      const css = getCssColor(color);
      const light = isLight(css);
      const border = light ? 'border:1.5px solid #ddd;' : '';

      const btn = document.createElement('button');
      btn.className = 'qo-prod__swatch-circle';
      btn.type = 'button';
      btn.dataset.color = color;
      btn.innerHTML = `
        <span class="qo-swatch-bg" style="background:${css};${border}border-radius:50%;display:block;width:100%;height:100%;"></span>
        <span class="qo-swatch-check">
          <svg viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8.5l3.5 3.5 6.5-7"/>
          </svg>
        </span>
      `;
      btn.addEventListener('click', () => toggleColor(color, btn));
      btn.addEventListener('mouseenter', () => showSwatchTooltip(btn, color, css));
      btn.addEventListener('mouseleave', hideSwatchTooltip);
      swatchesEl.appendChild(btn);
    });
  }

  function toggleColor(color, btn) {
    if (selectedColors.has(color)) {
      selectedColors.delete(color);
      btn.classList.remove('is-active');
    } else {
      selectedColors.add(color);
      btn.classList.add('is-active');
      const firstVariant = findVariant(color, null);
      if (firstVariant && firstVariant.image && mainImg) {
        mainImg.style.opacity='0.6'; mainImg.src=firstVariant.image; mainImg.onload=()=>mainImg.style.opacity='1';
      }
    }
    renderMatrix();
    smartFill();
    buildPrintConfigs();

  }

  /* Render matrix */
  const matrixEl  = document.getElementById('qo-matrix');
  const matrixSub = document.getElementById('qo-matrix-sub');

  function buildMatrixRow(color) {
    const css = getCssColor(color);
    const light = isLight(css);
    const safeId = color.replace(/[^a-z0-9]/gi,'-');
    const tr = document.createElement('tr');
    tr.dataset.color = color;

    // Color cell
    const tdColor = document.createElement('td');
    tdColor.className = 'td-color';
    tdColor.innerHTML = `<div class="qo-matrix__color-cell">
      <span class="qo-matrix__color-dot" style="background:${css};${light?'border-color:#bbb':''}"></span>
      <span style="font-size:0.78rem;font-weight:700;color:#333">${color}</span>
    </div>`;
    tr.appendChild(tdColor);

    const sizeCols = sizes.length > 0 ? sizes : [''];
    sizeCols.forEach(size => {
      const variant = findVariant(color, size || null);
      const td = document.createElement('td');
      const input = document.createElement('input');
      input.className = 'qo-matrix__input';
      input.type = 'number';
      input.placeholder = '0';
      input.min = '0';
      input.dataset.color = color;
      input.dataset.size = size;
      input.dataset.variant = variant ? variant.id : '';
      input.dataset.price = variant ? variant.price : 0;
      input.addEventListener('input', () => {
        if (parseInt(input.value) < 0) input.value = '';
        input.classList.toggle('has-value', parseInt(input.value) > 0);
        updateTotals();
        updateSummary();
    
      });
      td.appendChild(input);
      tr.appendChild(td);
    });

    // Row total
    const tdTotal = document.createElement('td');
    tdTotal.className = 'qo-matrix__row-total';
    tdTotal.id = `row-${safeId}`;
    tdTotal.textContent = '0';
    tr.appendChild(tdTotal);
    return tr;
  }

  function renderMatrix() {
    if (!matrixEl) return;

    if (selectedColors.size === 0) {
      matrixEl.innerHTML = '<p class="qo-matrix-empty">← Sélectionnez d\'abord une couleur</p>';
      updateATCBar(0);
      return;
    }

    // Build table structure once
    let tbody = matrixEl.querySelector('tbody');
    if (!tbody) {
      let html = '<table class="qo-matrix-table"><thead><tr>';
      html += '<th class="th-color">Couleur</th>';
      sizes.forEach(s => { html += `<th>${s.toUpperCase()}</th>`; });
      if (sizes.length === 0) html += '<th>QTÉ</th>';
      html += '<th>TOTAL</th></tr></thead><tbody></tbody><tfoot><tr><td style="font-weight:800">TOTAL</td>';
      sizes.forEach(size => { html += `<td class="qo-matrix__col-total" id="col-${size.replace(/[^a-z0-9]/gi,'-')}">0</td>`; });
      if (sizes.length === 0) html += '<td class="qo-matrix__col-total" id="col-single">0</td>';
      html += '<td class="qo-matrix__grand-total" id="grand-total">0</td></tr></tfoot></table>';
      matrixEl.innerHTML = html;
      tbody = matrixEl.querySelector('tbody');
    }

    // Remove rows for deselected colors
    tbody.querySelectorAll('tr[data-color]').forEach(tr => {
      if (!selectedColors.has(tr.dataset.color)) tr.remove();
    });

    // Add rows for new colors (preserve existing)
    [...selectedColors].forEach(color => {
      if (!tbody.querySelector(`tr[data-color="${color.replace(/"/g,'\\"')}"]`)) {
        tbody.appendChild(buildMatrixRow(color));
      }
    });

    updateTotals();
  }

  /* ── Smart quantity distribution ────────────────── */
  const SIZE_WEIGHTS = {
    'xs':1, 'xsmall':1,
    's':15, 'small':15,
    'm':30, 'medium':30,
    'l':35, 'large':35,
    'xl':15, 'xlarge':15,
    'xxl':5, '2xl':5, 'xxlarge':5,
    '3xl':3, 'xxxl':3,
    '4xl':2, '5xl':1,
    'one size':100, 'taille unique':100, 'tu':100,
  };

  function getSizeWeight(size) {
    if (!size) return 100;
    return SIZE_WEIGHTS[size.toLowerCase().trim()] || 10;
  }

  function smartFill() {
    if (!targetQty || targetQty < 1) return;
    const numColors = selectedColors.size;
    if (numColors === 0) return;

    const colorList = [...selectedColors];
    const basePerColor = Math.floor(targetQty / numColors);
    const colorRemainder = targetQty % numColors;

    colorList.forEach((color, colorIdx) => {
      const colorQty = basePerColor + (colorIdx < colorRemainder ? 1 : 0);
      const escaped = color.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
      const inputs = Array.from(matrixEl.querySelectorAll(`.qo-matrix__input[data-color="${escaped}"]`));
      if (inputs.length === 0) return;

      const weights = inputs.map(inp => getSizeWeight(inp.dataset.size));
      const totalWeight = weights.reduce((s, w) => s + w, 0);
      const exact = weights.map(w => (w / totalWeight) * colorQty);
      const floored = exact.map(Math.floor);
      let rem = colorQty - floored.reduce((s, v) => s + v, 0);

      // Distribute remainder to sizes with biggest fractional parts
      exact
        .map((v, i) => ({ i, frac: v - Math.floor(v) }))
        .sort((a, b) => b.frac - a.frac)
        .slice(0, rem)
        .forEach(({ i }) => floored[i]++);

      inputs.forEach((inp, i) => {
        const q = floored[i] || 0;
        inp.value = q > 0 ? q : '';
        inp.classList.toggle('has-value', q > 0);
      });
    });

    updateTotals();
    updateSummary();
  }

  /* Update totals */
  function updateTotals() {
    const rows = {}, cols = {};
    let grand = 0, totalPrice = 0;

    matrixEl.querySelectorAll('.qo-matrix__input').forEach(input => {
      const color = input.dataset.color;
      const size  = input.dataset.size || 'single';
      const qty   = parseInt(input.value) || 0;
      const price = parseInt(input.dataset.price) || 0;
      rows[color] = (rows[color] || 0) + qty;
      cols[size]  = (cols[size]  || 0) + qty;
      grand      += qty;
      totalPrice += qty * price;
    });

    Object.entries(rows).forEach(([color, total]) => {
      const el = document.getElementById(`row-${color.replace(/[^a-z0-9]/gi,'-')}`);
      if (el) el.textContent = total;
    });
    Object.entries(cols).forEach(([size, total]) => {
      const el = document.getElementById(`col-${size.replace(/[^a-z0-9]/gi,'-')}`);
      if (el) el.textContent = total;
    });
    const grandEl = document.getElementById('grand-total');
    if (grandEl) grandEl.textContent = grand;

    updateATCBar(grand, totalPrice);
  }

  /* ATC bar */
  function updateATCBar(total, totalPrice) {
    const qtyEl = document.getElementById('qo-bar-qty');
    if (qtyEl) qtyEl.textContent = total;
    const pl = document.getElementById('qo-bar-plural');
    if (pl) pl.textContent = total > 1 ? 's' : '';

    const minEl = document.getElementById('qo-bar-min');
    if (minEl) minEl.textContent = (total > 0 && total < MIN_QTY) ? `(min. ${MIN_QTY} — encore ${MIN_QTY - total})` : '';

    const priceEl = document.getElementById('qo-bar-price');
    if (priceEl) priceEl.textContent = totalPrice > 0 ? formatMoney(totalPrice) + ' total' : '';

    const atcBtn = document.getElementById('qo-atc');
    if (atcBtn) {
      atcBtn.disabled = total < MIN_QTY;
      atcBtn.textContent = total === 0
        ? 'Ajouter au panier'
        : total < MIN_QTY
          ? `Minimum ${MIN_QTY} pièces`
          : `Ajouter ${total} pièce${total>1?'s':''} au panier`;
    }
  }

  /* ── Print config per color ─────────────────── */
  const PRICES = {
    screenprint: {{ section.settings.price_screenprint }},
    dtg:         {{ section.settings.price_dtg }},
    dtf:         {{ section.settings.price_dtf }},
    embroidery:  {{ section.settings.price_embroidery }},
    extraPosition: {{ section.settings.price_extra_position }},
    extraColor:    {{ section.settings.price_extra_ink_color }},
    underbase:     {{ section.settings.price_underbase }},
    sizeA5:   {{ section.settings.price_size_a5 }},
    sizeA4:   {{ section.settings.price_size_a4 }},
    size30x30:{{ section.settings.price_size_30x30 }},
    sizeA3:   {{ section.settings.price_size_a3 }},
  };

  const POSITIONS_BY_METHOD = {
    screenprint: ['Devant','Dos','Manche G.','Manche D.'],
    dtg:         ['Devant','Dos','Manche G.','Manche D.'],
    dtf:         ['Devant','Dos','Manche G.','Manche D.','Col'],
    embroidery:  ['Poitrine G.','Poitrine D.','Dos','Manche G.','Manche D.'],
  };

  const SIZES_PRINT = [
    { id:'a5',    label:'A5 (21×15 cm)',  price: PRICES.sizeA5 },
    { id:'a4',    label:'A4 (21×30 cm)',  price: PRICES.sizeA4 },
    { id:'30x30', label:'30×30 cm',       price: PRICES.size30x30 },
    { id:'a3',    label:'A3 (30×42 cm)',  price: PRICES.sizeA3 },
  ];

  const METHOD_LABELS = {
    screenprint: 'Sérigraphie',
    dtg:         'Numérique (DTG)',
    dtf:         'Transfert (DTF)',
    embroidery:  'Broderie',
  };

  // positionConfigs: { [positionName]: { method, size, numColors, underbase } }
  const ALL_POSITIONS = ['Devant','Dos','Manche G.','Manche D.','Col','Poitrine G.','Poitrine D.'];
  const positionConfigs = {};
  const selectedPositions = new Set();

  // Keep colorConfigs as alias for summary compat
  const colorConfigs = positionConfigs;


  // Total print surcharge = sum across all configured positions
  function getTotalPrintSurcharge() {
    let total = 0;
    Object.values(positionConfigs).forEach(cfg => {
      if (!cfg.method) return;
      total += PRICES[cfg.method] || 0;
      if (cfg.size) { const sz = SIZES_PRINT.find(s => s.id === cfg.size); if (sz) total += sz.price; }
      if (cfg.method === 'screenprint') {
        total += Math.max(0, cfg.numColors - 1) * PRICES.extraColor;
        if (cfg.underbase) total += PRICES.underbase;
      }
    });
    return total;
  }

  // Keep legacy name used by summary
  function getPrintSurcharge() { return getTotalPrintSurcharge(); }

  function refreshAllCfgPrices() {
    const surcharge = getTotalPrintSurcharge();
    document.querySelectorAll('.qo-cfg-total-price').forEach(el => {
      el.textContent = surcharge > 0 ? `+ ${formatMoney(surcharge)} / pièce (total impression)` : '';
    });
  }

  // Load position icons
  const POS_ICONS = {};
  try {
    const raw = JSON.parse(document.getElementById('qo-pos-icons').textContent);
    Object.entries(raw).forEach(([k, v]) => { if (v) POS_ICONS[k] = v; });
  } catch(e) {}

  function buildPositionSelector() {
    const btnWrap = document.getElementById('qo-pos-btns');
    if (!btnWrap) return;
    btnWrap.innerHTML = '';
    ALL_POSITIONS.forEach(pos => {
      const hasImg = !!POS_ICONS[pos];
      const btn = document.createElement('button');
      btn.className = (hasImg ? 'qo-pos-img-btn' : 'qo-cfg-btn') + (selectedPositions.has(pos) ? ' is-active' : '');
      btn.type = 'button';
      if (hasImg) {
        btn.innerHTML = `<img src="${POS_ICONS[pos]}" alt="${pos}" class="qo-pos-img"><span class="qo-pos-label">${pos}</span>`;
      } else {
        btn.textContent = pos;
      }
      btn.addEventListener('click', () => {
        if (selectedPositions.has(pos)) {
          selectedPositions.delete(pos);
          delete positionConfigs[pos];
          btn.classList.remove('is-active');
        } else {
          selectedPositions.add(pos);
          positionConfigs[pos] = { method: null, size: null, numColors: 1, underbase: false };
          btn.classList.add('is-active');
        }
        buildPrintConfigs();
        refreshAllCfgPrices();
        updateSummary();
      });
      btnWrap.appendChild(btn);
    });
  }

  function buildPrintConfigs() {
    const wrap = document.getElementById('qo-print-configs');
    if (!wrap) return;

    if (selectedPositions.size === 0) {
      wrap.innerHTML = '';
      return;
    }

    // Incremental: add new position cards, remove deselected
    wrap.querySelectorAll('.qo-cfg-card[data-pos]').forEach(card => {
      if (!selectedPositions.has(card.dataset.pos)) card.remove();
    });

    [...selectedPositions].forEach(pos => {
      if (wrap.querySelector(`.qo-cfg-card[data-pos="${CSS.escape(pos)}"]`)) return; // already exists
      const cfg = positionConfigs[pos];
      const safeId = pos.replace(/[^a-z0-9]/gi, '-');

      const card = document.createElement('div');
      card.className = 'qo-cfg-card';
      card.dataset.pos = pos;

      card.innerHTML = `
        <div class="qo-cfg-header">
          <span class="qo-cfg-pos-icon">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 2a8 8 0 100 16A8 8 0 0010 2zm0 4v4m0 4h.01"/></svg>
          </span>
          <span class="qo-cfg-color-name">${pos}</span>
          <span class="qo-cfg-price-tag qo-cfg-total-price" id="cfg-price-${safeId}"></span>
        </div>

        <div class="qo-cfg-row">
          <label class="qo-cfg-label">Type d'impression</label>
          <div class="qo-cfg-btns" id="cfg-methods-${safeId}">
            ${['screenprint','dtg','dtf','embroidery'].map(m => `
              <button class="qo-cfg-btn${cfg.method===m?' is-active':''}" data-method="${m}" type="button">
                ${METHOD_LABELS[m]}
              </button>`).join('')}
          </div>
        </div>

        <div class="qo-cfg-row" id="cfg-size-row-${safeId}" style="${cfg.method && cfg.method!=='embroidery' ? '' : 'display:none'}">
          <label class="qo-cfg-label">Dimensions</label>
          <div class="qo-cfg-btns" id="cfg-sizes-${safeId}">
            ${SIZES_PRINT.map(s => `
              <button class="qo-cfg-btn${cfg.size===s.id?' is-active':''}" data-size="${s.id}" type="button">
                ${s.label}${s.price>0?' <small>+'+formatMoney(s.price)+'</small>':''}
              </button>`).join('')}
          </div>
        </div>

        <div class="qo-cfg-row" id="cfg-numcol-row-${safeId}" style="${cfg.method==='screenprint' ? '' : 'display:none'}">
          <label class="qo-cfg-label">Nombre de couleurs <span class="qo-cfg-hint">(couleur 1 incluse)</span></label>
          <div class="qo-cfg-btns" id="cfg-numcol-${safeId}">
            ${[1,2,3,4,5,6].map(n => `
              <button class="qo-cfg-btn qo-cfg-btn--sm${cfg.numColors===n?' is-active':''}" data-numcol="${n}" type="button">
                ${n}${n===6?'+':''}${n>1?' <small>+'+formatMoney((n-1)*PRICES.extraColor)+'</small>':''}
              </button>`).join('')}
          </div>
        </div>

        <div class="qo-cfg-row" id="cfg-ub-row-${safeId}" style="${cfg.method==='screenprint' ? '' : 'display:none'}">
          <label class="qo-cfg-label">Underbase <span class="qo-cfg-hint">(fond foncé)</span></label>
          <div class="qo-cfg-btns" id="cfg-ub-${safeId}">
            <button class="qo-cfg-btn${!cfg.underbase?' is-active':''}" data-ub="no" type="button">Non</button>
            <button class="qo-cfg-btn${cfg.underbase?' is-active':''}" data-ub="yes" type="button">Oui${PRICES.underbase>0?' <small>+'+formatMoney(PRICES.underbase)+'</small>':''}</button>
          </div>
        </div>
      `;

      wrap.appendChild(card);

      card.querySelectorAll(`#cfg-methods-${safeId} .qo-cfg-btn`).forEach(btn => {
        btn.addEventListener('click', () => {
          cfg.method = btn.dataset.method;
          card.querySelectorAll(`#cfg-methods-${safeId} .qo-cfg-btn`).forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          card.querySelector(`#cfg-size-row-${safeId}`).style.display   = cfg.method !== 'embroidery' ? '' : 'none';
          card.querySelector(`#cfg-numcol-row-${safeId}`).style.display = cfg.method === 'screenprint' ? '' : 'none';
          card.querySelector(`#cfg-ub-row-${safeId}`).style.display     = cfg.method === 'screenprint' ? '' : 'none';
          refreshAllCfgPrices();
          updateSummary();
        });
      });

      card.querySelectorAll(`#cfg-sizes-${safeId} .qo-cfg-btn`).forEach(btn => {
        btn.addEventListener('click', () => {
          cfg.size = btn.dataset.size;
          card.querySelectorAll(`#cfg-sizes-${safeId} .qo-cfg-btn`).forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          refreshAllCfgPrices();
          updateSummary();
        });
      });

      card.querySelectorAll(`#cfg-numcol-${safeId} .qo-cfg-btn`).forEach(btn => {
        btn.addEventListener('click', () => {
          cfg.numColors = parseInt(btn.dataset.numcol) || 1;
          card.querySelectorAll(`#cfg-numcol-${safeId} .qo-cfg-btn`).forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          refreshAllCfgPrices();
          updateSummary();
        });
      });

      card.querySelectorAll(`#cfg-ub-${safeId} .qo-cfg-btn`).forEach(btn => {
        btn.addEventListener('click', () => {
          cfg.underbase = btn.dataset.ub === 'yes';
          card.querySelectorAll(`#cfg-ub-${safeId} .qo-cfg-btn`).forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          refreshAllCfgPrices();
          updateSummary();
        });
      });
    });
  }

  /* Order summary */
  function updateSummary() {
    const wrap = document.getElementById('qo-summary-wrap');
    if (!wrap) return;

    const rows = [];
    if (matrixEl) {
      matrixEl.querySelectorAll('tbody tr[data-color]').forEach(tr => {
        const color = tr.dataset.color;
        const sizeQtys = [];
        tr.querySelectorAll('.qo-matrix__input').forEach(inp => {
          const qty = parseInt(inp.value) || 0;
          if (qty > 0) sizeQtys.push({ size: inp.dataset.size || '', qty, price: parseInt(inp.dataset.price) || 0 });
        });
        if (sizeQtys.length > 0) rows.push({ color, sizeQtys });
      });
    }

    if (rows.length === 0) {
      wrap.innerHTML = '<p class="qo-prod__summary-empty">Configurez votre commande pour voir le sommaire.</p>';
      return;
    }

    let html = `<table class="qo-prod__summary-table">
      <thead><tr>
        <th>Produit</th><th>Quantité</th><th>Impression</th><th>Coût</th>
      </tr></thead><tbody>`;

    let grandTotal = 0;

    // Build impression description from position configs (same for all color rows)
    const printParts = [];
    Object.entries(positionConfigs).forEach(([pos, cfg]) => {
      if (!cfg.method) return;
      let part = `<strong>${pos}</strong>: ${METHOD_LABELS[cfg.method] || cfg.method}`;
      if (cfg.size) part += ` / ${(SIZES_PRINT.find(s=>s.id===cfg.size)||{}).label||cfg.size}`;
      if (cfg.method === 'screenprint') {
        part += ` / ${cfg.numColors} coul.`;
        if (cfg.underbase) part += ' + Underbase';
      }
      printParts.push(part);
    });
    const printDesc = printParts.length > 0 ? printParts.join('<br>') : '—';
    const surcharge = getTotalPrintSurcharge();

    rows.forEach(row => {
      const qtyBreakdown = row.sizeQtys.map(s => `${s.size?s.size.toUpperCase()+'\xa0':''}${s.qty}`).join('&nbsp;&nbsp;');
      const totalQty = row.sizeQtys.reduce((s, i) => s + i.qty, 0);
      const baseTotal = row.sizeQtys.reduce((s, i) => s + i.qty * i.price, 0);
      const printTotal = totalQty * surcharge;
      const rowTotal = baseTotal + printTotal;
      grandTotal += rowTotal;

      html += `<tr>
        <td><strong>${data.title}</strong><br><span style="color:#888;font-size:0.78rem">${row.color}</span></td>
        <td style="font-size:0.78rem">${qtyBreakdown}</td>
        <td style="font-size:0.75rem;color:#555;line-height:1.5">${printDesc}</td>
        <td class="td-cost">${formatMoney(rowTotal)}</td>
      </tr>`;
    });

    const tps  = Math.round(grandTotal * 0.05);
    const tvq  = Math.round(grandTotal * 0.09975);
    const totalTax = grandTotal + tps + tvq;

    html += `</tbody>
    <tfoot>
      <tr>
        <td colspan="3" style="text-align:right;padding-right:16px;padding-top:14px;border-top:2px solid #111;color:#555;font-size:0.8rem">Sous-total</td>
        <td class="td-cost" style="border-top:2px solid #111;padding-top:14px;font-weight:700">${formatMoney(grandTotal)}</td>
      </tr>
      <tr>
        <td colspan="3" style="text-align:right;padding-right:16px;color:#888;font-size:0.78rem">TPS (5%)</td>
        <td class="td-cost" style="color:#888;font-size:0.78rem">${formatMoney(tps)}</td>
      </tr>
      <tr>
        <td colspan="3" style="text-align:right;padding-right:16px;color:#888;font-size:0.78rem">TVQ (9,975%)</td>
        <td class="td-cost" style="color:#888;font-size:0.78rem">${formatMoney(tvq)}</td>
      </tr>
      <tr>
        <td colspan="3" style="text-align:right;padding-right:16px;font-weight:900;font-size:1rem;padding-top:10px;border-top:1px solid #ddd">TOTAL (taxes incluses)</td>
        <td class="td-cost" style="font-weight:900;font-size:1rem;padding-top:10px;border-top:1px solid #ddd;color:#C9A96E">${formatMoney(totalTax)}</td>
      </tr>
    </tfoot></table>
    <div class="qo-summary-actions">
      <button class="qo-summary__send-btn" id="qo-open-quote-modal" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
        Envoyer la soumission par courriel
      </button>
    </div>`;

    wrap.innerHTML = html;

    // Re-attach open modal button
    const openBtn = document.getElementById('qo-open-quote-modal');
    if (openBtn) openBtn.addEventListener('click', openQuoteModal);
  }

  /* ── Quote modal ──────────────────────────── */
  function openQuoteModal() {
    const modal = document.getElementById('qo-quote-modal');
    if (modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
  }

  function closeQuoteModal() {
    const modal = document.getElementById('qo-quote-modal');
    if (modal) { modal.style.display = 'none'; document.body.style.overflow = ''; }
    const status = document.getElementById('qo-send-status');
    if (status) { status.textContent = ''; status.className = 'qo-qm__status'; }
  }

  document.getElementById('qo-qm-close').addEventListener('click', closeQuoteModal);
  document.getElementById('qo-qm-backdrop').addEventListener('click', closeQuoteModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeQuoteModal(); });

  function buildQuoteBody(clientEmail, clientName, clientIp) {
    const rows = [];
    if (matrixEl) {
      matrixEl.querySelectorAll('tbody tr[data-color]').forEach(tr => {
        const color = tr.dataset.color;
        const sizeQtys = [];
        tr.querySelectorAll('.qo-matrix__input').forEach(inp => {
          const qty = parseInt(inp.value) || 0;
          if (qty > 0) sizeQtys.push({ size: inp.dataset.size || '', qty, price: parseInt(inp.dataset.price) || 0 });
        });
        if (sizeQtys.length > 0) rows.push({ color, sizeQtys });
      });
    }

    let body = `SOUMISSION PRINTPRESS\n`;
    body += `${'='.repeat(50)}\n\n`;
    body += `Client : ${clientName || '—'}\n`;
    body += `Courriel : ${clientEmail}\n`;
    body += `IP : ${clientIp || '—'}\n`;
    body += `Date : ${new Date().toLocaleString('fr-CA')}\n`;
    body += `Produit : ${data.title}\n\n`;
    body += `${'─'.repeat(50)}\n`;
    body += `DÉTAILS DE LA COMMANDE\n\n`;

    let grandTotal = 0;

    // Print config (position-based, same for all colors)
    const configuredPositions = Object.entries(positionConfigs).filter(([,cfg]) => cfg.method);
    if (configuredPositions.length) {
      body += `Impression :\n`;
      configuredPositions.forEach(([pos, cfg]) => {
        body += `  ${pos}: ${METHOD_LABELS[cfg.method] || cfg.method}`;
        if (cfg.size) body += ` / ${(SIZES_PRINT.find(s=>s.id===cfg.size)||{}).label||cfg.size}`;
        if (cfg.method === 'screenprint') {
          body += ` / ${cfg.numColors} couleur(s)`;
          if (cfg.underbase) body += ' + Underbase';
        }
        body += '\n';
      });
      body += '\n';
    }

    const surcharge = getTotalPrintSurcharge();
    rows.forEach(row => {
      const totalQty = row.sizeQtys.reduce((s, i) => s + i.qty, 0);
      const baseTotal = row.sizeQtys.reduce((s, i) => s + i.qty * i.price, 0);
      const rowTotal = baseTotal + totalQty * surcharge;
      grandTotal += rowTotal;

      body += `Couleur : ${row.color}\n`;
      body += `Quantités : ${row.sizeQtys.map(s => `${s.size?s.size.toUpperCase()+' ':''} ${s.qty}`).join(' | ')}\n`;
      body += `Sous-total ligne : ${formatMoney(rowTotal)}\n\n`;
    });

    const tps = Math.round(grandTotal * 0.05);
    const tvq = Math.round(grandTotal * 0.09975);
    const totalTax = grandTotal + tps + tvq;

    body += `${'─'.repeat(50)}\n`;
    body += `Sous-total : ${formatMoney(grandTotal)}\n`;
    body += `TPS (5%) : ${formatMoney(tps)}\n`;
    body += `TVQ (9,975%) : ${formatMoney(tvq)}\n`;
    body += `TOTAL (taxes incluses) : ${formatMoney(totalTax)}\n`;

    return body;
  }

  document.getElementById('qo-send-quote-btn').addEventListener('click', async () => {
    const emailInput = document.getElementById('qo-client-email');
    const nameInput  = document.getElementById('qo-client-name');
    const marketing  = document.getElementById('qo-marketing-consent');
    const statusEl   = document.getElementById('qo-send-status');
    const sendBtn    = document.getElementById('qo-send-quote-btn');

    const email = emailInput ? emailInput.value.trim() : '';
    if (!email || !email.includes('@')) {
      statusEl.textContent = 'Veuillez entrer une adresse courriel valide.';
      statusEl.className = 'qo-qm__status qo-qm__status--error';
      return;
    }

    sendBtn.disabled = true;
    sendBtn.textContent = 'Envoi en cours…';
    statusEl.textContent = '';

    // Get IP address
    let clientIp = '—';
    try {
      const ipRes = await fetch('https://api.ipify.org?format=json');
      const ipData = await ipRes.json();
      clientIp = ipData.ip || '—';
    } catch(e) {}

    const clientName = nameInput ? nameInput.value.trim() : '';
    const quoteBody  = buildQuoteBody(email, clientName, clientIp);

    // Send quote to info@printpress.store via Shopify contact form
    const formData = new FormData();
    formData.append('form_type', 'contact');
    formData.append('utf8', '✓');
    formData.append('contact[email]', email);
    formData.append('contact[name]', clientName || email);
    formData.append('contact[phone]', '');
    formData.append('contact[body]', quoteBody);

    try {
      const res = await fetch('/contact', { method: 'POST', body: formData });
      if (!res.ok) throw new Error();

      // Newsletter opt-in
      if (marketing && marketing.checked) {
        const nlData = new FormData();
        nlData.append('form_type', 'customer');
        nlData.append('utf8', '✓');
        nlData.append('contact[email]', email);
        nlData.append('contact[tags]', 'newsletter, soumission');
        fetch('/contact', { method: 'POST', body: nlData }).catch(() => {});
      }

      statusEl.textContent = '✓ Soumission envoyée ! Notre équipe vous contactera dans les 24h.';
      statusEl.className = 'qo-qm__status qo-qm__status--success';
      if (sendBtn) { sendBtn.disabled = false; sendBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg> Envoyer la soumission'; }
    } catch(e) {
      statusEl.textContent = 'Une erreur est survenue. Veuillez réessayer ou nous contacter directement.';
      statusEl.className = 'qo-qm__status qo-qm__status--error';
      if (sendBtn) { sendBtn.disabled = false; sendBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg> Envoyer la soumission'; }
    }
  });

  /* Add to cart */
  async function addToCart() {
    const inputs = matrixEl ? matrixEl.querySelectorAll('.qo-matrix__input:not(:disabled)') : [];
    const items = [];
    inputs.forEach(input => {
      const qty = parseInt(input.value) || 0;
      if (qty > 0 && input.dataset.variant) items.push({ id: parseInt(input.dataset.variant), quantity: qty });
    });

    if (items.length === 0) { showFeedback('Entrez au moins une quantité.', 'error'); return; }
    const totalQty = items.reduce((s, i) => s + i.quantity, 0);
    if (totalQty < MIN_QTY) { showFeedback(`Minimum ${MIN_QTY} pièces requis.`, 'error'); return; }

    const atcBtn = document.getElementById('qo-atc');
    atcBtn.disabled = true;
    atcBtn.textContent = 'Ajout en cours…';

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });
      if (!res.ok) { const err = await res.json(); throw new Error(err.description || 'Erreur'); }
      showFeedback(`✓ ${totalQty} pièces ajoutées !`, 'success');
      atcBtn.textContent = '✓ Ajouté !';
      fetch('/cart.js').then(r=>r.json()).then(d=>{
        document.querySelectorAll('.qo-header__cart-count').forEach(el=>el.textContent=d.item_count);
      }).catch(()=>{});
    } catch(e) {
      showFeedback(e.message || 'Une erreur est survenue.', 'error');
      atcBtn.disabled = false;
      atcBtn.textContent = 'Ajouter au panier';
    }
  }

  function showFeedback(msg, type) {
    const el = document.getElementById('qo-feedback');
    if (!el) return;
    el.textContent = msg;
    el.style.color = type === 'success' ? '#16a34a' : '#dc2626';
    setTimeout(() => { el.textContent = ''; }, 4000);
  }

  document.getElementById('qo-atc').addEventListener('click', addToCart);

  /* Reveal steps based on progress */
  /* Triangle click — scroll to step 3 */
  const nextArrow = document.getElementById('qo-next-arrow');
  if (nextArrow) {
    nextArrow.addEventListener('click', () => {
      const step3 = document.querySelector('.qo-prod__step-print');
      if (step3) step3.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  /* Init */
  buildSwatches();
  renderMatrix();
  buildPositionSelector();
  updateATCBar(0);
})();
</script>

