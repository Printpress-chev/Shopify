<!-- Position icons from section settings -->
{%- assign _pi_devant     = '' -%}{%- if section.settings.pos_icon_devant     != blank -%}{%- assign _pi_devant     = section.settings.pos_icon_devant     | image_url: width: 140 -%}{%- endif -%}
{%- assign _pi_dos        = '' -%}{%- if section.settings.pos_icon_dos        != blank -%}{%- assign _pi_dos        = section.settings.pos_icon_dos        | image_url: width: 140 -%}{%- endif -%}
{%- assign _pi_manche_g   = '' -%}{%- if section.settings.pos_icon_manche_g   != blank -%}{%- assign _pi_manche_g   = section.settings.pos_icon_manche_g   | image_url: width: 140 -%}{%- endif -%}
{%- assign _pi_manche_d   = '' -%}{%- if section.settings.pos_icon_manche_d   != blank -%}{%- assign _pi_manche_d   = section.settings.pos_icon_manche_d   | image_url: width: 140 -%}{%- endif -%}
{%- assign _pi_col        = '' -%}{%- if section.settings.pos_icon_col        != blank -%}{%- assign _pi_col        = section.settings.pos_icon_col        | image_url: width: 140 -%}{%- endif -%}
{%- assign _pi_poitrine_g = '' -%}{%- if section.settings.pos_icon_poitrine_g != blank -%}{%- assign _pi_poitrine_g = section.settings.pos_icon_poitrine_g | image_url: width: 140 -%}{%- endif -%}
{%- assign _pi_poitrine_d = '' -%}{%- if section.settings.pos_icon_poitrine_d != blank -%}{%- assign _pi_poitrine_d = section.settings.pos_icon_poitrine_d | image_url: width: 140 -%}{%- endif -%}
<script type="application/json" id="qo-pos-icons">
{
  "Devant":      {{ _pi_devant     | json }},
  "Dos":         {{ _pi_dos        | json }},
  "Manche G.":   {{ _pi_manche_g   | json }},
  "Manche D.":   {{ _pi_manche_d   | json }},
  "Col":         {{ _pi_col        | json }},
  "Poitrine G.": {{ _pi_poitrine_g | json }},
  "Poitrine D.": {{ _pi_poitrine_d | json }}
}
</script>

<!-- Product data for JS -->
<script type="application/json" id="qo-product-json">
{
  "id": {{ product.id }},
  "title": {{ product.title | json }},
  "type": {{ product.type | json }},
  "price_min": {{ product.price_min }},
  "price_max": {{ product.price_max }},
  "options_with_values": [
    {%- for option in product.options_with_values -%}
    {
      "name": {{ option.name | json }},
      "position": {{ option.position }},
      "values": {{ option.values | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "variants": [
    {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "title": {{ variant.title | json }},
      "option1": {{ variant.option1 | json }},
      "option2": {{ variant.option2 | json }},
      "option3": {{ variant.option3 | json }},
      "price": {{ variant.price }},
      "available": {{ variant.available }},
      "image": {{ variant.image.src | image_url: width: 800 | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "images": [
    {%- for img in product.images limit: 8 -%}
    {
      "src": {{ img | image_url: width: 800 | json }},
      "thumb": {{ img | image_url: width: 150 | json }},
      "alt": {{ img.alt | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

<div class="qo-prod">

  <!-- Back link -->
  <div class="qo-prod__nav">
    <a class="qo-prod__back" href="javascript:history.back()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Retour au catalogue
    </a>
  </div>

  <!-- ══ TOP : Image + Info ══ -->
  <div class="qo-prod__top">

    <!-- Gallery -->
    <div class="qo-prod__gallery">
      <div class="qo-prod__main-img-wrap">
        {%- if product.featured_image -%}
          <img class="qo-prod__main-img" id="qo-main-img"
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.title | escape }}">
        {%- else -%}
          <div class="qo-prod__no-img">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="4" y="8" width="40" height="32" rx="4"/>
              <path d="M4 30l10-10 8 8 6-6 16 12"/>
              <circle cx="34" cy="18" r="4"/>
            </svg>
          </div>
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="qo-prod__thumbs" id="qo-thumbs">
          {%- for img in product.images limit: 8 -%}
            <button class="qo-prod__thumb{% if forloop.first %} is-active{% endif %}"
              data-src="{{ img | image_url: width: 900 }}" type="button">
              <img src="{{ img | image_url: width: 150 }}" alt="{{ img.alt | escape }}">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Info -->
    <div class="qo-prod__info">
      {%- if product.type != blank -%}
        <p class="qo-prod__type">{{ product.type }}</p>
      {%- endif -%}
      <h1 class="qo-prod__title">{{ product.title }}</h1>

      <p class="qo-prod__price">
        {%- if product.price_min != product.price_max -%}
          À partir de <strong>{{ product.price_min | money }}</strong>
        {%- else -%}
          <strong>{{ product.price_min | money }}</strong>
        {%- endif -%}
        <span>/ pièce</span>
      </p>

      {%- if product.description != blank -%}
        <div class="qo-prod__desc">{{ product.description }}</div>
      {%- endif -%}

      <!-- Target qty -->
      <div class="qo-prod__target" id="qo-target" style="display:none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg>
        Objectif : <strong id="qo-target-qty"></strong> pièces
      </div>

      <!-- Size guide -->
      {%- if section.settings.show_size_guide -%}
      <div class="qo-prod__size-guide">
        <div class="qo-prod__size-guide-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
          GUIDE DES TAILLES
        </div>
        <p class="qo-prod__size-guide-sub">Mesurez sous vos bras, autour de votre poitrine</p>
        <div class="qo-prod__size-table-wrap">
          <table class="qo-prod__size-table">
            <thead>
              <tr id="qo-sg-sizes-row"></tr>
            </thead>
            <tbody>
              <tr id="qo-sg-cm-row"></tr>
            </tbody>
          </table>
          <div class="qo-prod__size-unit-row">
            <span class="qo-prod__size-unit" id="qo-unit-label">EN CM</span>
            <button class="qo-prod__unit-toggle" id="qo-unit-toggle" type="button">
              Afficher en pouces
            </button>
          </div>
        </div>
      </div>
      {%- endif -%}

      <!-- Badges -->
      <div class="qo-prod__badges">
        <div class="qo-prod__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Minimum {{ section.settings.min_qty }} pièces</span>
        </div>
        <div class="qo-prod__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Livraison rapide</span>
        </div>
        <div class="qo-prod__badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          <span>Impression professionnelle</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ ÉTAPES 1 & 2 : Couleurs | Tailles ══ -->
  <div class="qo-prod__steps-row">

    <!-- Étape 1 : Couleurs (dark) -->
    <div class="qo-prod__step qo-prod__step--colors">
      <div class="qo-prod__step-inner">
        <h2 class="qo-prod__step-title">
          <span class="qo-prod__step-num">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="9"/><path d="M10 6v4m0 4h.01"/></svg>
          </span>
          1&nbsp;: CHOISISSEZ VOS <strong id="qo-step1-type">COULEURS</strong>
        </h2>
        <p class="qo-prod__step-sub">Cliquez pour sélectionner. Survolez pour voir le nom.</p>
        <div class="qo-prod__swatches" id="qo-swatches"></div>
      </div>
    </div>

    <!-- Flèche diagonale -->
    <div class="qo-prod__step-arrow" aria-hidden="true">
      <svg viewBox="0 0 60 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 0 L60 60 L0 120" fill="#111" stroke="none"/>
      </svg>
    </div>

    <!-- Étape 2 : Tailles (light) -->
    <div class="qo-prod__step qo-prod__step--sizes">
      <div class="qo-prod__step-inner">
        <h2 class="qo-prod__step-title qo-prod__step-title--dark">
          <span class="qo-prod__step-num qo-prod__step-num--dark">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="9"/><path d="M10 6v4m0 4h.01"/></svg>
          </span>
          2&nbsp;: CHOISISSEZ VOS <strong>TAILLES</strong>
        </h2>
        <p class="qo-prod__step-sub qo-prod__step-sub--dark" id="qo-matrix-sub">
          Notre minimum est {{ section.settings.min_qty }} pièces par commande.
        </p>
        <div id="qo-matrix"></div>
        <div class="qo-prod__next-arrow" id="qo-next-arrow" aria-hidden="true">
          <div class="qo-prod__next-triangle"></div>
        </div>
      </div>
    </div>

  </div>

  <!-- ══ ÉTAPE 3 : Configuration d'impression ══ -->
  <div class="qo-prod__step-print">
    <div class="qo-prod__step-print-inner">
      <h2 class="qo-prod__step3-title">
        <span class="qo-prod__step-num qo-prod__step-num--light">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="9"/><path d="M10 6v4m0 4h.01"/></svg>
        </span>
        3&nbsp;: CONFIGURATION D'<strong>IMPRESSION</strong>
      </h2>
      <p class="qo-prod__step3-sub">Choisissez les positions à imprimer. Chaque position aura sa propre configuration.</p>

      <!-- Position selector -->
      <div class="qo-cfg-section">
        <label class="qo-cfg-label">Positions à imprimer <span class="qo-cfg-hint">(plusieurs possibles)</span></label>
        <div class="qo-cfg-btns" id="qo-pos-btns"></div>
      </div>

      <!-- Per-position config cards -->
      <div id="qo-print-configs"></div>
    </div>
  </div>

  <!-- ══ ÉTAPE 4 : Sommaire de commande ══ -->
  <div class="qo-prod__summary-section">
    <div class="qo-prod__summary-inner">
      <h2 class="qo-prod__summary-title">SOMMAIRE DE <strong>COMMANDE</strong></h2>
      <div id="qo-summary-wrap">
        <p class="qo-prod__summary-empty">Configurez votre commande pour voir le sommaire.</p>
      </div>
    </div>
  </div>

  <!-- ══ Modal soumission par courriel ══ -->
  <div class="qo-qm" id="qo-quote-modal" aria-modal="true" role="dialog" style="display:none">
    <div class="qo-qm__backdrop" id="qo-qm-backdrop"></div>
    <div class="qo-qm__box">
      <button class="qo-qm__close" id="qo-qm-close" type="button" aria-label="Fermer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <h3 class="qo-qm__title">Envoyer ma soumission</h3>
      <p class="qo-qm__desc">Votre soumission sera transmise à notre équipe. Nous vous répondrons dans les 24h.</p>

      <div class="qo-qm__field">
        <label class="qo-qm__label" for="qo-client-email">Votre adresse courriel *</label>
        <input class="qo-qm__input" type="email" id="qo-client-email" placeholder="vous@exemple.com" autocomplete="email" required>
      </div>

      <div class="qo-qm__field">
        <label class="qo-qm__label" for="qo-client-name">Votre nom / entreprise</label>
        <input class="qo-qm__input" type="text" id="qo-client-name" placeholder="Ex: Jean Tremblay" autocomplete="name">
      </div>

      <label class="qo-qm__checkbox-label">
        <input type="checkbox" id="qo-marketing-consent" checked>
        <span>Je souhaite recevoir des offres et nouvelles de PrintPress</span>
      </label>

      <button class="qo-qm__send-btn" id="qo-send-quote-btn" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
        Envoyer la soumission
      </button>

      <p class="qo-qm__status" id="qo-send-status"></p>
    </div>
  </div>

  <!-- Sticky ATC bar -->
  <div class="qo-prod__atc-bar" id="qo-atc-bar">
    <div class="qo-prod__atc-summary">
      <div class="qo-prod__atc-qty">
        <span id="qo-bar-qty">0</span> pièce<span id="qo-bar-plural"></span>
        <span class="qo-prod__atc-min" id="qo-bar-min"></span>
      </div>
      <div class="qo-prod__atc-price" id="qo-bar-price"></div>
    </div>
    <div class="qo-prod__atc-actions">
      <p class="qo-prod__atc-feedback" id="qo-feedback"></p>
      <button class="qo-prod__atc-btn" id="qo-atc" type="button">Ajouter au panier</button>
    </div>
  </div>

</div>

{% stylesheet %}

* { box-sizing: border-box; }

.qo-prod {
  background: #fff;
  padding-bottom: 90px;
}

/* Back nav */
.qo-prod__nav {
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 32px 0;
}

.qo-prod__back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  color: #888;
  text-decoration: none;
  transition: color 0.2s;
}
.qo-prod__back:hover { color: #C9A96E; }
.qo-prod__back svg { width: 16px; height: 16px; }

/* ══ TOP ══ */
.qo-prod__top {
  max-width: 1280px;
  margin: 0 auto;
  padding: 28px 32px 48px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}

@media (max-width: 900px) {
  .qo-prod__top { grid-template-columns: 1fr; gap: 28px; padding: 20px 16px 32px; }
}

/* Gallery */
.qo-prod__main-img-wrap {
  aspect-ratio: 4/5;
  background: #f0f0f0;
  overflow: hidden;
}

.qo-prod__main-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: opacity 0.2s;
}

.qo-prod__no-img {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: #ccc;
}
.qo-prod__no-img svg { width: 64px; }

.qo-prod__thumbs {
  display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap;
}

.qo-prod__thumb {
  width: 60px; height: 60px;
  border: 2px solid #e5e5e5;
  background: #f5f5f5;
  cursor: pointer; padding: 0;
  overflow: hidden;
  transition: border-color 0.2s;
}
.qo-prod__thumb:hover { border-color: #aaa; }
.qo-prod__thumb.is-active { border-color: #C9A96E; }
.qo-prod__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Info */
.qo-prod__type {
  font-size: 0.72rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.14em;
  color: #C9A96E; margin: 0 0 8px;
}

.qo-prod__title {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 900; color: #111;
  margin: 0 0 12px;
  text-transform: uppercase;
  line-height: 1.1;
}

.qo-prod__price {
  font-size: 1.3rem; font-weight: 800; color: #111;
  margin: 0 0 20px;
}
.qo-prod__price span { font-size: 0.85rem; font-weight: 500; color: #888; }

.qo-prod__desc {
  font-size: 0.88rem; color: #555; line-height: 1.7;
  margin-bottom: 20px;
  border-top: 1px solid #eee;
  padding-top: 18px;
}

.qo-prod__target {
  display: flex; align-items: center; gap: 8px;
  background: #fdf9ee; border: 1.5px solid #C9A96E;
  border-radius: 6px; padding: 10px 14px;
  font-size: 0.85rem; color: #C9A96E; font-weight: 600;
  margin-bottom: 20px;
}
.qo-prod__target svg { width: 16px; flex-shrink: 0; }

/* Size guide */
.qo-prod__size-guide {
  background: #111;
  color: #fff;
  padding: 20px 24px;
  margin-bottom: 20px;
}

.qo-prod__size-guide-header {
  display: flex; align-items: center; gap: 8px;
  font-size: 0.82rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.1em;
  margin-bottom: 6px;
}
.qo-prod__size-guide-header svg { width: 16px; height: 16px; }

.qo-prod__size-guide-sub {
  font-size: 0.75rem; color: rgba(255,255,255,0.55);
  margin: 0 0 14px;
}

.qo-prod__size-table-wrap { overflow-x: auto; }

.qo-prod__size-table {
  border-collapse: collapse;
  font-size: 0.78rem;
  white-space: nowrap;
}

.qo-prod__size-table th,
.qo-prod__size-table td {
  border: 1px solid rgba(255,255,255,0.15);
  padding: 7px 14px;
  text-align: center;
  font-weight: 700;
}

.qo-prod__size-table th { letter-spacing: 0.08em; }
.qo-prod__size-table td { color: rgba(255,255,255,0.75); }

.qo-prod__size-unit-row {
  display: flex; align-items: center; justify-content: flex-end;
  gap: 10px; margin-top: 6px;
}
.qo-prod__size-unit {
  font-size: 0.68rem; color: rgba(255,255,255,0.4);
  letter-spacing: 0.1em;
}
.qo-prod__unit-toggle {
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 6px;
  color: rgba(255,255,255,0.7);
  font-size: 0.68rem; font-weight: 600;
  padding: 3px 9px; cursor: pointer;
  transition: background 0.15s;
}
.qo-prod__unit-toggle:hover { background: rgba(255,255,255,0.22); }

/* Next step triangle — integrated into background */
.qo-prod__next-arrow {
  display: flex;
  justify-content: center;
  margin-top: 28px;
}

.qo-prod__next-triangle {
  width: 0;
  height: 0;
  border-left: 44px solid transparent;
  border-right: 44px solid transparent;
  border-top: 32px solid #f5f5f5;
}


/* Badges */
.qo-prod__badges {
  display: flex; flex-direction: column; gap: 10px;
}
.qo-prod__badge {
  display: flex; align-items: center; gap: 10px;
  font-size: 0.82rem; font-weight: 600; color: #555;
}
.qo-prod__badge svg { width: 17px; height: 17px; color: #C9A96E; flex-shrink: 0; }

/* ══ ÉTAPES 1 & 2 ══ */
.qo-prod__steps-row {
  display: grid;
  grid-template-columns: 1fr 60px 1fr;
  min-height: 260px;
}

@media (max-width: 900px) {
  .qo-prod__steps-row { grid-template-columns: 1fr; }
  .qo-prod__step-arrow { display: none; }
}

.qo-prod__step { display: flex; align-items: center; }

.qo-prod__step--colors {
  background: #111;
  padding: 40px 40px 40px 32px;
}

.qo-prod__step--sizes {
  background: #e8e8e8;
  padding: 40px 32px 40px 24px;
}

.qo-prod__step-inner { width: 100%; }

/* Diagonal arrow between steps */
.qo-prod__step-arrow {
  background: #e8e8e8;
  position: relative;
  overflow: visible;
  z-index: 1;
}
.qo-prod__step-arrow svg {
  position: absolute;
  left: -1px; top: 0;
  width: 61px; height: 100%;
}

/* Step titles */
.qo-prod__step-title {
  font-size: clamp(0.7rem, 1.2vw, 0.85rem);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #fff;
  margin: 0 0 6px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.qo-prod__step-title strong { color: #C9A96E; }

.qo-prod__step-title--dark { color: #111; }
.qo-prod__step-title--dark strong { color: #111; text-decoration: underline; text-underline-offset: 3px; }

.qo-prod__step-num svg { width: 18px; height: 18px; flex-shrink: 0; }
.qo-prod__step-num { color: #fff; display: flex; }
.qo-prod__step-num--dark { color: #111; }
.qo-prod__step-num--light { color: #111; }

.qo-prod__step-sub {
  font-size: 0.78rem; color: rgba(255,255,255,0.5);
  margin: 0 0 20px;
}
.qo-prod__step-sub--dark { color: #777; }

/* ── Color swatches (circles) ── */
.qo-prod__swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.qo-prod__swatch-circle {
  position: relative;
  width: 44px; height: 44px;
  border-radius: 50%;
  border: 3px solid transparent;
  cursor: pointer;
  transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
  flex-shrink: 0;
  background: #ccc;
  padding: 0;
  overflow: hidden;
}

.qo-prod__swatch-circle:hover {
  transform: scale(1.12);
  box-shadow: 0 0 0 2px rgba(255,255,255,0.5);
}

.qo-prod__swatch-circle.is-active {
  border-color: #22c55e;
  box-shadow: 0 0 0 2px #22c55e;
  transform: scale(1.08);
}

.qo-prod__swatch-circle .qo-swatch-bg {
  width: 100%; height: 100%;
  border-radius: 50%;
  display: block;
}

/* Checkmark overlay */
.qo-prod__swatch-circle .qo-swatch-check {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(34,197,94,0.75);
  display: flex; align-items: center; justify-content: center;
  opacity: 0;
  transition: opacity 0.15s;
}
.qo-prod__swatch-circle.is-active .qo-swatch-check { opacity: 1; }
.qo-prod__swatch-circle .qo-swatch-check svg { width: 18px; height: 18px; }

/* Rich color tooltip */
.qo-swatch-tooltip {
  position: fixed;
  z-index: 9999;
  pointer-events: none;
  display: none;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 10px 36px rgba(0,0,0,0.22);
  overflow: hidden;
  width: 150px;
  transform-origin: bottom center;
}
.qo-swatch-tooltip.is-visible {
  display: block;
  animation: qo-smoosh 0.45s cubic-bezier(0.34,1.56,0.64,1) forwards;
}

@keyframes qo-smoosh {
  0%   { transform: scale(0.4) translateY(10px); opacity: 0; }
  60%  { transform: scale(1.06) translateY(-2px); opacity: 1; }
  80%  { transform: scale(0.97) translateY(0); }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

.qo-swatch-tooltip__color {
  width: 100%;
  height: 90px;
  display: block;
}
.qo-swatch-tooltip__name {
  padding: 9px 10px;
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #111;
